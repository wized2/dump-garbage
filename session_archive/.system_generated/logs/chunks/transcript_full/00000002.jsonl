t-color:var(--accent);\"></div>\n2183:           <div class=\"set-row\"><div><div class=\"lbl\">System sounds</div><div class=\"sub\">Play sound on notifications</div></div><div class=\"toggle on\"><div class=\"knob\"></div></div></div>\n2184:         </div>\n2185:       </div>`,\n2186:     apps: ()=>`\n2187:       <div class=\"settings-content\">\n2188:         <div class=\"set-section\">\n2189:           <div class=\"set-h\"><i data-lucide=\"layout-grid\"></i>Installed applications</div>\n2190:           ${installedApps.map(a=>`<div class=\"set-row\"><div class=\"lbl\">${a.name}</div><div class=\"sub\">v${a.version}</div></div>`).join('')}\n2191:         </div>\n2192:       </div>`,\n2193:     about: ()=>`\n2194:       <div class=\"settings-content\">\n2195:         <div class=\"set-section\">\n2196:           <div class=\"set-h\"><i data-lucide=\"box\"></i>Endroid OS</div>\n2197:           <div class=\"set-row\"><div class=\"lbl\">Version</div><div class=\"sub\" style=\"text-align:right;\">1.0.0 (build 2026.08)</div></div>\n2198:           <div class=\"set-row\"><div class=\"lbl\">Kernel</div><div class=\"sub\" style=\"text-align:right;\">Linux, custom‑compiled</div></div>\n2199:           <div class=\"set-row\"><div class=\"lbl\">Runtime</div><div class=\"sub\" style=\"text-align:right;\">WebKitGTK</div></div>\n2200:           <div class=\"set-row\"><div class=\"lbl\">Storage used</div><div class=\"sub\" style=\"text-align:right;\">412 MB / 500 MB</div></div>\n2201:         </div>\n2202:       </div>`,\n2203:   };\n2204:   function draw(p){\n2205:     content.innerHTML = panels[p]();\n2206:     lucide.createIcons();\n2207:     if(p==='appearance'){\n2208:       content.querySelectorAll('#theme-seg button').forEach(b=>{\n2209:         b.onclick = ()=>{\n2210:           document.body.dataset.theme = b.dataset.t;\n2211:           content.querySelectorAll('#theme-seg button').forEach(x=>x.classList.remove('active'));\n2212:           b.classList.add('active');\n2213