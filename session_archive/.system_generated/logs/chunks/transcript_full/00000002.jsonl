49: /* ============================================================\n1750:    APP: CALCULATOR\n1751:    ============================================================ */\n1752: function renderCalc(body){\n1753:   body.innerHTML = `\n1754:     <div class=\"calc\">\n1755:       <div class=\"calc-hist\" id=\"c-hist\">&nbsp;</div>\n1756:       <div class=\"calc-disp\" id=\"c-disp\">0</div>\n1757:       <div class=\"calc-grid\" id=\"c-grid\"></div>\n1758:     </div>\n1759:   `;\n1760:   const keys = [\n1761:     ['C','fn'],['(',  'fn'],[')','fn'],['÷','op'],\n1762:     ['7',''],['8',''],['9',''],['×','op'],\n1763:     ['4',''],['5',''],['6',''],['−','op'],\n1764:     ['1',''],['2',''],['3',''],['+','op'],\n1765:     ['0',''],['.',''],['⌫','fn'],['=','eq'],\n1766:   ];\n1767:   const grid = body.querySelector('#c-grid');\n1768:   keys.forEach(([label,cls])=>{\n1769:     const b = document.createElement('button');\n1770:     b.className = 'calc-btn '+cls;\n1771:     b.textContent = label;\n1772:     b.style.gridColumn = label==='0' ? '' : '';\n1773:     grid.appendChild(b);\n1774:     b.onclick = ()=>handleKey(label);\n1775:   });\n1776:   const disp = body.querySelector('#c-disp');\n1777:   const hist = body.querySelector('#c-hist');\n1778:   let expr = '';\n1779:   function handleKey(k){\n1780:     if(k==='C'){ expr=''; disp.textContent='0'; hist.textContent='\\u00A0'; return; }\n1781:     if(k==='⌫'){ expr = expr.slice(0,-1); disp.textContent = expr || '0'; return; }\n1782:     if(k==='='){\n1783:       try{\n1784:         const safe = expr.replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-');\n1785:         // eslint-disable-next-line no-eval\n1786:         const result = Function('\"use strict\";return ('+safe+')')();\n1787:         hist.textContent = expr + ' =';\n1788:         expr = String(result);\n1789:         disp.textContent = expr;\n1790:       }catch(e){ disp.textContent='Error'; expr=''; }\n1791:       return;\n1792:     }\n1793:     expr += k;\n1794:     disp.textContent = expr;\n1795:   }\n1796:   document.addEventListener('keydown', function kh(e){\n1797:     if(!document.body.contains(grid)) { document.removeEventListener('keydown', kh); return; }\n1798:   });\n1799: }\n1800: \n1801: /* ============================================================\n1802:    APP: INSTALLER\n1803:    ============================================================ */\n1804: let installedApps = [\n1805:   {name:'Photo Viewer', version:'1.2.0', icon:'image'},\n1806:   {name:'Weather', version:'0.9.4', icon:'cloud-sun'},\n1807: ];\n1808: function renderInstaller(body){\n1809:   body.innerHTML = `\n1810:     <div class=\"app-pane\">\n1811:       <div class=\"content\" style=\"padding:0;\">\n1812:         <div class=\"installer-drop\" id=\"inst-drop\">\n1813:           <i data-lucide=\"package-plus\"></i>\n1814:           <div class=\"h\">Drop a real .epk package to install</div>\n1815:           <div class=\"s\">Zip archive containing manifest.json + your app's HTML/CSS/JS</div>\n1816:           <div style=\"display:flex;gap:8px;justify-content:center;margin-top:14px;\">\n1817:             <button id=\"inst-browse\">Browse for .epk</button>\n1818:             <button id=\"inst-sample\" style=\"background:var(--bg-1);border:1px solid var(--line-soft);color:var(--text-1);border-radius:8px;padding:8px 16px;font-size:12.5px;cursor:pointer;font-family:var(--font-body);\">Download sample .epk</button>\n1819:           </div>\n1820:         </div>\n1821: \n1822:         <div style=\"margin:0 20px 20px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:12px;padding:16px;\">\n1823:           <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px;\">\n1824:             <i data-lucide=\"app-window\" style=\"width:15px;height:15px;stroke:var(--accent);\"></i>\n1825:             <div style=\"font-family:var(--font-display);font-weight:600;font-size:13px;color:var(--text-0);\">Install a web app</div>\n1826:           </div>\n1827:           <div style=\"font-size:11.5px;color:var(--text-2);margin-bottom:10px;line-height:1.5;\">\n1828:             Paste a manifest — <b style=\"color:var(--text-1);\">name</b> and <b style=\"color:var(--text-1);\">url</b> are required.\n1829:             <b style=\"color:var(--text-1);\">icon</b> can be a Lucide icon name (e.g. \"rocket\") or raw &lt;svg&gt; markup.\n1830:           </div>\n1831:           <textarea id=\"wa-manifest\" spellcheck=\"false\" style=\"width:100%;min-height:110px;background:var(--bg-1);border:1px solid var(--line-soft);border-radius:8px;padding:10px;color:var(--text-0);font-family:var(--font-mono);font-size:11.5px;outline:none;resize:vertical;\">{\n1832:   \"name\": \"Wikipedia\",\n1833:   \"url\": \"https://en.wikipedia.org\",\n1834:   \"icon\": \"book-open\",\n1835:   \"description\": \"The free encyclopedia\"\n1836: }</textarea>\n1837:           <div style=\"display:flex;gap:8px;margin-top:10px;\">\n1838:             <button id=\"wa-install\" style=\"flex:1;background:var(--accent);border:none;border-radius:8px;padding:9px;color:#08110F;font-weight:600;font-size:12.5px;cursor:pointer;font-family:var(--font-body);\">Install web app</button>\n1839:             <button id=\"wa-example\" style=\"background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;padding:9px 14px;color:var(--text-1);font-size:12.5px;cursor:pointer;font-family:var(--font-body);\">Try SVG example</button>\n1840:           </div>\n1841:           <div id=\"wa-status\" style=\"font-size:11px;color:var(--text-2);margin-top:8px;\"></div>\n1842:         </div>\n1843: \n1844:         <div class=\"manifest-box\" id=\"inst-manifest\" style=\"display:none;\"></div>\n1845:         <div style=\"padding:0 20px 6px;font-size:11.5px;color:var(--text-2);text-transform:uppercase;letter-spacing:0.5px;\">Installed applications</div>\n1846:         <div class=\"installed-list\" id=\"inst-list\"></div>\n1847:       </div>\n1848:     </div>\n1849:   `;\n1850:   lucide.createIcons();\n1851:   const list = body.querySelector('#inst-list');\n1852:   function drawList(){\n1853:     list.innerHTML = installedApps.map(a=>`\n1854:       <div class=\"installed-row\">\n1855:         <div class=\"ico\">${iconMarkup(a)}</div>\n1856:         <div class=\"info\"><div class=\"n\">${a.name}</div><div class=\"v\">${a.version?'v'+a.version:(a.url||'')}</div></div>\n1857:         <button class=\"win-btn\" data-name=\"${a.name}\" title=\"Uninstall\"><i data-lucide=\"trash-2\" style=\"width:14px;height:14px;\"></i></button>\n1858:       </div>`).join('');\n1859:     lucide.createIcons();\n1860:     list.querySelectorAll('button[data-name]').forEach(btn=>{\n1861:       btn.onclick = ()=>{\n1862:         const target = installedApps.find(a=>a.name===btn.dataset.name);\n1863:         installedApps = installedApps.filter(a=>a.name!==btn.dataset.name);\n1864:         if(target && target.appKey){ delete APPS[target.appKey]; closeWindow(target.appKey); rebuildLauncherAndPins(); }\n1865:         drawList();\n1866:         showToast('trash-2','App removed', btn.dataset.name+' was uninstalled');\n1867:       };\n1868:     });\n1869:   }\n1870:   function showManifestPreview(manifest){\n1871:     const manifestBox = body.querySelector('#inst-manifest');\n1872:     manifestBox.style.display='block';\n1873:     manifestBox.textContent = JSON.stringify(manifest, null, 2);\n1874:   }\n1875: \n1876:   const MIME_MAP = {\n1877:     css:'text/css', js:'application/javascript', mjs:'application/javascript',\n1878:     png:'image/png', jpg:'image/jpeg', jpeg:'image/jpeg', svg:'image/svg+xml',\n1879:     gif:'image/gif', webp:'image/webp', json:'application/json',\n1880:     woff:'font/woff', woff2:'font/woff2', ttf:'font/ttf', mp3:'audio/mpeg', wav:'audio/wav'\n1881:   };\n1882: \n1883:   async function installEpkFile(file){\n1884:     if(typeof JSZip === 'undefined'){\n1885:       showToast('alert-triangle','Installer unavailable', 'The .epk reader failed to load — check your connection and try again.');\n1886:       return;\n1887:     }\n1888:     let zip;\n1889:     try{ zip = await JSZip.loadAsync(file); }\n1890:     catch(e){ showToast('alert-triangle','Invalid package', \"That file isn't a valid .epk (zip) archive.\"); return; }\n1891: \n1892:     const manifestEntry = zip.file('manifest.json');\n1893:     if(!manifestEntry){ showToast('alert-triangle','Missing manifest', 'This .epk has no manifest.json at its root.'); return; }\n1894: \n1895:     let manifest;\n1896:     try{ manifest = JSON.parse(await manifestEntry.async('text')); }\n1897:     catch(e){ showToast('alert-triangle','Invalid manifest', \"manifest.json isn't valid JSON.\"); return; }\n1898: \n1899:     if(!manifest.name || !manifest.main){\n1900:       showToast('alert-triangle','Incomplete manifest', '\"name\" and \"main\" are required in manifest.json.'); return;\n1901:     }\n1902: \n1903:     const mainPath = manifest.main.replace(/^\\.\\//,'').replace(/^\\//,'');\n1904:     const mainEntry = zip.file(mainPath) || zip.file(manifest.main);\n1905:     if(!mainEntry){ showToast('alert-triangle','Entry file missing', `Couldn't find \"${manifest.main}\" inside the package.`); return; }\n1906: \n1907:     let html = await mainEntry.async('text');\n1908: \n1909:     // Build blob URLs for every other asset in the package (css, js, images, fonts...)\n1910:     const blobMap = {};\n1911:     const paths = Object.keys(zip.files).filter(p => !zip.files[p].dir && p !== mainPath && p !== 'manifest.json');\n1912:     for(const path of paths){\n1913:       const ext = path.split('.').pop().toLowerCase();\n1914:       const mime = MIME_MAP[ext] || 'application/octet-stream';\n1915:       const raw = await zip.files[path].async('blob');\n1916:       const url = URL.createObjectURL(new Blob([raw], {type: mime}));\n1917:       blobMap[path] = url;\n1918:       blobMap[path.replace(/^\\.\\//,'')] = url;\n1919:     }\n1920: \n1921:     // Rewrite relative src/href references in the entry HTML to point at the blob assets\n1922:     html = html.replace(/(src|href)=[\"']([^\"']+)[\"']/g, (m, attr, val)=>{\n1923:       if(/^(https?:)?\\/\\//i.test(val) || val.startsWith('data:') || val.startsWith('blob:') || val.startsWith('#')) return m;\n1924:       const clean = val.replace(/^\\.\\//,'').replace(/^\\//,'');\n1925:       return blobMap[clean] ? `${attr}=\"${blobMap[clean]}\"` : m;\n1926:     });\n1927: \n1928:     const htmlUrl = URL.createObjectURL(new Blob([html], {type:'text/html'}));\n1929: \n1930:     let icon = 'package', svg = null;\n1931:     if(typeof manifest.icon === 'string' && manifest.icon.trim().startsWith('<svg')){\n1932:       svg = manifest.icon.trim();\n1933:     } else if(manifest.icon){\n1934:       icon = resolveIconName(manifest.icon.trim().toLowerCase());\n1935:     }\n1936: \n1937:     const key = 'epk_' + Date.now();\n1938:     APPS[key] = { name: manifest.name, icon, svg, pinned:false, render: (b)=>renderWebApp(b, htmlUrl) };\n1939:     installedApps.push({name: manifest.name, version: manifest.version || '1.0.0', icon, svg, appKey: key});\n1940:     showManifestPreview(manifest);\n1941:     rebuildLauncherAndPins();\n1942:     drawList();\n1943:     pushNotif('package-check','check-circle','Installation complete', `${manifest.name} was installed from ${file.name}`);\n1944:   }\n1945: \n1946:   const drop = body.querySelector('#inst-drop');\n1947:   drop.addEventListener('dragover', e=>{ e.preventDefault(); drop.style.borderColor='var(--accent)'; });\n1948:   drop.addEventListener('dragleave', ()=>{ drop.style.borderColor='var(--line)'; });\n1949:   drop.addEventListener('drop', e=>{\n1950:     e.preventDefault(); drop.style.borderColor='var(--line)';\n1951:     const f = e.dataTransfer.files[0];\n1952:     if(f) installEpkFile(f);\n1953:   });\n1954:   body.querySelector('#inst-browse').onclick = ()=>{\n1955:     const input = document.createElement('input');\n1956:     input.type='file'; input.accept='.epk,.zip';\n1957:     input.onchange = ()=>{ if(input.files[0]) installEpkFile(input.files[0]); };\n1958:     input.click();\n1959:   };\n1960:   body.querySelector('#inst-sample').onclick = async ()=>{\n1961:     if(typeof JSZip === 'undefined'){ showToast('alert-triangle','Unavailable','The zip library failed to load.'); return; }\n1962:     const zip = new JSZip();\n1963:     zip.file('manifest.json', JSON.stringify({\n1964:       name: \"Hello Endroid\",\n1965:       version: \"1.0.0\",\n1966:       author: \"Endroid\",\n1967:       main: \"index.html\",\n1968:       icon: \"sparkles\",\n1969:       permissions: []\n1970:     }, null, 2));\n1971:     zip.file('index.html', `<!DOCTYPE html><html><head><meta charset=\"utf-8\">\n1972: <link rel=\"stylesheet\" href=\"style.css\"></head>\n1973: <body>\n1974:   <h1>Hello from a real .epk!</h1>\n1975:   <p>This app was unzipped, its manifest parsed, and its files loaded entirely in your browser.</p>\n1976:   <button onclick=\"document.getElementById('c').textContent = Number(document.getElementById('c').textContent)+1\">Click me</button>\n1977:   <p>Clicks: <span id=\"c\">0</span></p>\n1978: </body></html>`);\n1979:     zip.file('style.css', `body{font-family:sans-serif;background:#12151B;color:#EDEFF3;padding:40px;text-align:center;}\n1980: button{background:#4FD1C5;border:none;border-radius:8px;padding:10px 18px;font-size:14px;cursor:pointer;margin-top:16px;}`);\n1981:     const blob = await zip.generateAsync({type:'blob'});\n1982:     const url = URL.createObjectURL(blob);\n1983:     const a = document.createElement('a');\n1984:     a.href = url; a.download = 'hello-endroid.epk';\n1985:     a.click();\n1986:     setTimeout(()=>URL.revokeObjectURL(url), 2000);\n1987:   };\n1988: \n1989:   /* ---- Web app installer ---- */\n1990:   const waStatus = body.querySelector('#wa-status');\n1991:   body.querySelector('#wa-example').onclick = ()=>{\n1992:     body.querySelector('#wa-manifest').value = JSON.stringify({\n1993:       name: \"Endroid\",\n1994:       url: \"https://endroid.zone.id\",\n1995:       icon: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4FD1C5\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"4\"/><path d=\"M8 12h8M12 8v8\"/></svg>',\n1996:       description: \"Endroid brand site\"\n1997:     }, null, 2);\n1998:   };\n1999:   body.querySelector('#wa-install').onclick = ()=>{\n2000:     let manifest;\n2001:     try{ manifest = JSON.parse(body.querySelector('#wa-manifest').value); }\n2002:     catch(e){ waStatus.textContent = 'Invalid JSON manifest.'; waStatus.style.color='var(--danger)'; return; }\n2003:     if(!manifest.name || !manifest.url){\n2004:       waStatus.textContent = '\"name\" and \"url\" are required fields.'; waStatus.style.color='var(--danger)'; return;\n2005:     }\n2006:     let target = manifest.url;\n2007:     if(!/^https?:\\/\\//i.test(target)) target = 'https://' + target;\n2008: \n2009:     const appEntry = { name: manifest.name, pinned:false, render: (b)=>renderWebApp(b, target) };\n2010:     if(typeof manifest.icon === 'string' && manifest.icon.trim().startsWith('<svg')){\n2011:       appEntry.svg = manifest.icon.trim();\n2012:       appEntry.icon = 'app-window';\n2013:     } else {\n2014:       appEntry.icon = resolveIconName((manifest.icon||'').trim().toLowerCase());\n2015:       if(appEntry.icon === 'app-window' && manifest.icon){\n2016:         waStatus.textContent = `Icon \"${manifest.icon}\" isn't a known Lucide icon — using a default icon instead.`;\n2017:         waStatus.style.color='var(--warn)';\n2018:       } else {\n2019:         waStatus.textContent = '';\n2020:       }\n2021:     }\n2022:     const key = 'web_' + Date.now();\n2023:     APPS[key] = appEntry;\n2024:     installedApps.push({name: manifest.name, url: target, icon: appEntry.icon, svg: appEntry.svg, appKey: key});\n2025:     rebuildLauncherAndPins();\n2026:     drawList();\n2027:     pushNotif('app-window','check-circle','Web app installed', manifest.name+' was added to your launcher');\n2028:     if(!waStatus.textContent) waStatus.textContent = 'Installed — find it in the launcher.';\n2029:     if(!waStatus.style.color || waStatus.style.color==='var(--warn)') { if(!waStatus.style.color) waStatus.style.color='var(--accent)'; }\n2030:   };\n2031: \n2032:   drawList();\n2033: }\n2034: function renderWebApp(body, url){\n2035:   body.innerHTML = `<iframe src=\"${url}\" style=\"width:100%;height:100%;border:none;background:#fff;\" referrerpolicy=\"no-referrer\" sandbox=\"allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox\"></iframe>`;\n2036: }\n2037: function rebuildLauncherAndPins(){\n2038:   buildLauncher(document.getElementById('launcher-input')?.value || '');\n2039: }\n2040: \n2041: /* ============================================================\n2042:    APP: TERMINAL\n2043:    ============================================================ */\n2044: function renderTerminal(body){\n2045:   body.innerHTML = `<div class=\"term\" id=\"term-out\"></div>`;\n2046:   const out = body.querySelector('#term-out');\n2047:   const cwd = '~';\n2048:   function printLine(html){\n2049:     const l = document.createElement('div');\n2050:     l.className='term-line';\n2051:     l.innerHTML = html;\n2052:     out.appendChild(l);\n2053:     out.scrollTop = out.scrollHeight;\n2054:   }\n2055:   function newPrompt(){\n2056:     const row = document.createElement('div');\n2057:     row.className='term-input-row';\n2058:     row.innerHTML = `<span class=\"term-prompt\">endroid@device:${cwd}$</span><input type=\"text\" autocomplete=\"off\" spellcheck=\"false\">`;\n2059:     out.appendChild(row);\n2060:     const input = row.querySelector('input');\n2061:     input.focus();\n2062:     input.addEventListener('keydown', e=>{\n2063:       if(e.key==='Enter'){\n2064:         const cmd = input.value.trim();\n2065:         row.remove();\n2066:         printLine(`<span class=\"term-prompt