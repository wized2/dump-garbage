{\r\n33:     Write-Host \"[*] Powering off existing EndroidOS VM...\"\r\n34:     & $vboxPath controlvm $vmName poweroff 2>$null | Out-Null\r\n35:     Start-Sleep -Seconds 2\r\n36:     Write-Host \"[*] Removing old VM...\"\r\n37:     & $vboxPath unregistervm $vmName --delete 2>$null | Out-Null\r\n38:     Start-Sleep -Seconds 1\r\n39: }\r\n40: \r\n41: # Clean up leftover VM folder if present\r\n42: $vmFolder = \"$env:USERPROFILE\\VirtualBox VMs\\$vmName\"\r\n43: if (Test-Path $vmFolder) {\r\n44:     Remove-Item -Recurse -Force $vmFolder -ErrorAction SilentlyContinue\r\n45: }\r\n46: \r\n47: # 1. Create and Register VM\r\n48: Write-Host \"[+] Creating VirtualBox VM: $vmName...\"\r\n49: & $vboxPath createvm --name $vmName --ostype \"Linux_64\" --register\r\n50: \r\n51: # 2. Configure Hardware (2048 MB RAM, 2 CPUs, VMSVGA Graphics, Network NAT)\r\n52: Write-Host \"[+] Configuring Hardware: 2048 MB RAM, 2 CPUs, 128 MB VRAM...\"\r\n53: $modArgs = @(\r\n54:     \"modifyvm\", $vmName,\r\n55:     \"--memory\", \"2048\",\r\n56:     \"--cpus\", \"2\",\r\n57:     \"--vram\", \"128\",\r\n58:     \"--graphicscontroller\", \"vmsvga\",\r\n59:     \"--boot1\", \"dvd\",\r\n60:     \"--boot2\", \"disk\",\r\n61:     \"--boot3\", \"none\",\r\n62:     \"--boot4\", \"none\",\r\n63:     \"--audio-driver\", \"dsound\",\r\n64:     \"--nic1\", \"nat\",\r\n65:     \"--natpf1\", \"http8080,tcp,,8080,,8080\",\r\n66:     \"--natpf1\", \"http80,tcp,,8000,,80\"\r\n67: )\r\n68: & $vboxPath $modArgs\r\n69: \r\n70: # 3. Attach Optical Drive (IDE) with Endroid OS ISO\r\n71: Write-Host \"[+] Attaching Live Boot ISO ($isoPath)...\"\r\n72: & $vboxPath storagectl $vmName --name \"IDE Controller\" --add ide\r\n73: & $vboxPath storageattach $vmName --storagectl \"IDE Controller\" --port 0 --device 0 --type dvddrive --medium $isoPath\r\n74: \r\n75: # 4. Attach Virtual SATA Hard Disk (20 GB) for Disk Installation & Persistence Testing\r\n76: Write-Host \"[+] Creating and attaching 20 GB virtual SATA Hard Disk for Bare-Metal Installer...\"\r\n77: $vdiPath = Join-Path $vmFolder \"Endroid_Disk.vdi\"\r\n78: & $vboxPath storagectl $vmName --name \"SATA Controller\" --add sata --controller IntelAhci --portcount 2\r\n79: & $vboxPath createmedium disk --filename $vdiPath --size 20480 --format VDI\r\n80: & $vboxPath storageattach $vmName --storagectl \"SATA Controller\" --port 0 --device 0 --type hdd --medium $vdiPath\r\n81: \r\n82: # 5. Start VM\r\n83: Write-Host \"==================================================\"\r\n84: Write-Host \"[+] Launching Endroid OS in VirtualBox GUI...\"\r\n85: Write-Host \"==================================================\"\r\n86: & $vboxPath startvm $vmName --type gui\r\n87: \r\n88: Write-Host \"[+] VirtualBox VM is now running!\"\r\n89: Write-Host \"[+] Web Desktop is also accessible on host at: http://localhost:8080\"\r\n90: \nThe above content shows the entire, complete file contents of the requested file.\n"}
