{"step_index":57,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-19T06:05:52Z","content":"Created At: 2026-08-19T06:05:52Z\nCompleted At: 2026-08-19T06:05:52Z\nFile Path: `file:///C:/Users/Bullettemporary/.gemini/antigravity/scratch/dump-garbage/iso-builder/build_real_iso.py`\nTotal Lines: 473\nTotal Bytes: 19040\nShowing lines 1 to 473\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\r\n2: \"\"\"\r\n3: Endroid OS — Master Bare-Metal ISO Builder v7 (Complete Graphical Desktop)\r\n4: - Fully self-contained, standalone operating system (zero host dependencies).\r\n5: - Boots into full graphical Xorg + JWM + Dillo desktop automatically.\r\n6: - Bundles 64-bit Linux Node.js runtime and full Endroid Web Desktop server.\r\n7: - Supports UEFI (GPT) and Legacy BIOS (MBR) bare-metal booting.\r\n8: - Auto-mounts persistent data storage (LABEL=ENDROID_DATA) across reboots.\r\n9: \"\"\"\r\n10: \r\n11: import os, sys, shutil, gzip, io, struct, tarfile, zipfile, urllib.request\r\n12: \r\n13: BASE_DIR     = os.path.dirname(os.path.abspath(__file__))\r\n14: PROJECT_ROOT = os.path.dirname(BASE_DIR)\r\n15: KERNEL_ASSETS= os.path.join(BASE_DIR, \"kernel-assets\")\r\n16: ISOLINUX_BINS= os.path.join(KERNEL_ASSETS, \"isolinux\")\r\n17: TCE_CACHE    = os.path.join(BASE_DIR, \"tce_cache\")\r\n18: ISO_OUT      = os.path.join(PROJECT_ROOT, \"endroid-os-x86_64.iso\")\r\n19: STAGING_DIR  = os.path.join(BASE_DIR, \"iso_staging\")\r\n20: \r\n21: print(\"=\" * 65)\r\n22: print(\"  Endroid OS — Master Bare-Metal OS Builder v7\")\r\n23: print(\"  Target: Physical PC Hardware (Full GUI Desktop, UEFI + BIOS)\")\r\n24: print(\"=\" * 65)\r\n25: \r\n26: # Clean staging area\r\n27: if os.path.exists(STAGING_DIR):\r\n28:     shutil.rmtree(STAGING_DIR)\r\n29: os.makedirs(os.path.join(STAGING_DIR, \"isolinux\"), exist_ok=True)\r\n30: os.makedirs(os.path.join(STAGING_DIR, \"EFI\", \"BOOT\"), exist_ok=True)\r\n31: os.makedirs(os.path.join(STAGING_DIR, \"boot\"), exist_ok=True)\r\n32: os.makedirs(os.path.join(STAGING_DIR, \"cce\", \"optional\"), exist_ok=True)\r\n33: \r\n34: # ---------------------------------------------------------------\r\n35: # STEP 1: Extract TinyCore base rootfs\r\n36: # ---------------------------------------------------------------\r\n37: print(\"[1/5] Extracting base Linux rootfs...\")\r\n38: base_gz = os.path.join(KERNEL_ASSETS, \"corepure64.gz\")\r\n39: with gzip.open(base_gz, 'rb') as f:\r\n40:     cpio_data = f.read()\r\n41: print(f\"  Base CPIO size: {len(cpio_data)/1024/1024:.2f} MB\")\r\n42: \r\n43: def parse_cpio_newc(data):\r\n44:     \"\"\"Parse newc CPIO archive, preserving all exact header fields.\"\"\"\r\n45:     pos = 0\r\n46:     entries = []\r\n47:     while pos < len(data):\r\n48:         if data[pos:pos+6] != b'070701':\r\n49:             break\r\n50:         header = data[pos:pos+110]\r\n51:         namesize = int(header[94:102], 16)\r\n52:         filesize = int(header[54:62], 16)\r\n53:         name = data[pos+110:pos+110+namesize-1].decode('utf-8', errors='replace')\r\n54:         name_pad = (4 - ((110 + namesize) % 4)) % 4\r\n55:         data_start = pos + 110 + namesize + name_pad\r\n56:         file_data = data[data_start:data_start+filesize]\r\n57:         \r\n58:         mode = int(header[14:22], 16)\r\n59:         uid = int(header[22:30], 16)\r\n60:         gid = int(header[30:38], 16)\r\n61:         nlink = int(header[38:46], 16)\r\n62:         mtime = int(header[46:54], 16)\r\n63:         devmajor = int(header[62:70], 16)\r\n64:         devminor = int(header[70:78], 16)\r\n65:         rdevmajor = int(header[78:86], 16)\r\n66:         rdevminor = int(header[86:94], 16)\r\n67:         \r\n68:         entries.append((name, mode, uid, gid, nlink, mtime, devmajor, devminor, rdevmajor, rdevminor, file_data))\r\n69:         if name == 'TRAILER!!!':\r\n70:             break\r\n71:         data_pad = (4 - (filesize % 4)) % 4\r\n72:         pos = data_start + filesize + data_pad\r\n73:     return entries\r\n74: \r\n75: _ino_counter = [1000000]\r\n76: \r\n77: def make_cpio_entry(name, data=b'', mode=0o100755, uid=0, gid=0, nlink=1, mtime=0, devmajor=3, devminor=1, rdevmajor=0, rdevminor=0):\r\n78:     name_bytes = name.encode('utf-8') + b'\\x00'\r\n79:     namesize = len(name_bytes)\r\n80:     filesize = len(data)\r\n81:     if name == 'TRAILER!!!':\r\n82:         ino = 0\r\n83:     else:\r\n84:         _ino_counter[0] += 1\r\n85:         ino = _ino_counter[0]\r\n86:     header = (\r\n87:         b'070701'\r\n88:         + f'{ino:08X}'.encode()\r\n89:         + f'{mode:08X}'.encode()\r\n90:         + f'{uid:08X}'.encode()\r\n91:         + f'{gid:08X}'.encode()\r\n92:         + f'{nlink:08X}'.encode()\r\n93:         + f'{mtime:08X}'.encode()\r\n94:         + f'{filesize:08X}'.encode()\r\n95:         + f'{devmajor:08X}'.encode()\r\n96:         + f'{devminor:08X}'.encode()\r\n97:         + f'{rdevmajor:08X}'.encode()\r\n98:         + f'{rdevminor:08X}'.encode()\r\n99:         + f'{namesize:08X}'.encode()\r\n100:         + b'00000000'\r\n101:     )\r\n102:     raw = header + name_bytes\r\n103:     raw += b'\\x00' * ((4 - (len(raw) % 4)) % 4)\r\n104:     raw += data\r\n105:     raw += b'\\x00' * ((4 - (len(data) % 4)) % 4)\r\n106:     return raw\r\n107: \r\n108: # ---------------------------------------------------------------\r\n109: # STEP 2: Build merged CPIO (Base + Node.js + Endroid OS)\r\n110: # ---------------------------------------------------------------\r\n111: print(\"[2/5] Building merged rootfs CPIO with standalone Node.js and Endroid OS...\")\r\n112: base_entries = parse_cpio_newc(cpio_data)\r\n113: base_names = {e[0] for e in base_entries if e[0] != 'TRAILER!!!'}\r\n114: new_cpio = io.BytesIO()\r\n115: \r\n116: for name, mode, uid, gid, nlink, mtime, devmajor, devminor, rdevmajor, rdevminor, data in base_entries:\r\n117:     if name == 'TRAILER!!!':\r\n118:         continue\r\n119:     new_cpio.write(make_cpio_entry(name, data, mode, uid, gid, nlink, mtime, devmajor, devminor, rdevmajor, rdevminor))\r\n120: \r\n121: def add_dir(name, mode=0o040755):\r\n122:     if name not in base_names:\r\n123:         new_cpio.write(make_cpio_entry(name, b'', mode))\r\n124:         base_names.add(name)\r\n125: \r\n126: def add_file(name, data, mode=0o100755):\r\n127:     new_cpio.write(make_cpio_entry(name, data, mode))\r\n128:     base_names.add(name)\r\n129: \r\n130: def add_text(name, text, mode=0o100644):\r\n131:     new_cpio.write(make_cpio_entry(name, text.encode('utf-8'), mode))\r\n132:     base_names.add(name)\r\n133: \r\n134: # Ensure overlay directories\r\n135: overlay_dirs = [\r\n136:     'opt', 'opt/endroid', 'opt/endroid/server', 'opt/endroid/public',\r\n137:     'opt/endroid/vfs', 'opt/endroid/vfs/home', 'opt/endroid/vfs/home/user',\r\n138:     'opt/endroid/vfs/home/user/Desktop', 'opt/endroid/vfs/etc', 'opt/endroid/vfs/etc/endroid',\r\n139:     'usr', 'usr/local', 'usr/local/bin', 'lib64', 'boot', 'boot/tce', 'etc/sysconfig', 'var/log', 'mnt/endroid_storage'\r\n140: ]\r\n141: for d in overlay_dirs:\r\n142:     add_dir(d)\r\n143: \r\n144: # Extract and bundle standalone 64-bit Node.js binary\r\n145: node_tar_path = os.path.join(KERNEL_ASSETS, \"node-linux-x64.tar.gz\")\r\n146: if os.path.exists(node_tar_path):\r\n147:     print(\"  Extracting 64-bit Linux Node.js runtime...\")\r\n148:     with tarfile.open(node_tar_path, 'r:gz') as tar:\r\n149:         for member in tar.getmembers():\r\n150:             if member.name.endswith('/bin/node'):\r\n151:                 f = tar.extractfile(member)\r\n152:                 node_binary_data = f.read()\r\n153:                 add_file('usr/local/bin/node', node_binary_data, 0o100755)\r\n154:                 add_file('bin/node', node_binary_data, 0o100755)\r\n155:                 print(f\"  [OK] Bundled Node.js runtime ({len(node_binary_data)/1024/1024:.2f} MB)\")\r\n156:                 break\r\n157: \r\n158: # Bundle server, public, and vfs files\r\n159: def bundle_directory(src_dir, target_prefix):\r\n160:     count = 0\r\n161:     for root, dirs, files in os.walk(src_dir):\r\n162:         rel_dir = os.path.relpath(root, src_dir).replace('\\\\', '/')\r\n163:         dest_dir = target_prefix if rel_dir == '.' else f\"{target_prefix}/{rel_dir}\"\r\n164:         add_dir(dest_dir)\r\n165:         for f in files:\r\n166:             full_path = os.path.join(root, f)\r\n167:             dest_file = f\"{dest_dir}/{f}\"\r\n168:             try:\r\n169:                 with open(full_path, 'rb') as fh:\r\n170:                     add_file(dest_file, fh.read(), 0o100644)\r\n171:                 count += 1\r\n172:             except Exception as e:\r\n173:                 print(f\"  [SKIP] {dest_file}: {e}\")\r\n174:     return count\r\n175: \r\n176: server_count = bundle_directory(os.path.join(PROJECT_ROOT, 'server'), 'opt/endroid/server')\r\n177: public_count = bundle_directory(os.path.join(PROJECT_ROOT, 'public'), 'opt/endroid/public')\r\n178: vfs_count    = bundle_directory(os.path.join(PROJECT_ROOT, 'vfs'), 'opt/endroid/vfs')\r\n179: print(f\"  Bundled Endroid OS: {server_count} server files, {public_count} web UI files, {vfs_count} VFS template files.\")\r\n180: \r\n181: # Initial sysconfig for Xorg and desktop\r\n182: add_text('etc/sysconfig/Xserver', 'Xorg\\n', 0o100644)\r\n183: add_text('etc/sysconfig/desktop', 'jwm\\n', 0o100644)\r\n184: \r\n185: # ---------------------------------------------------------------\r\n186: # Add Bare-Metal bootsync.sh (Startup & Persistence Manager)\r\n187: # ---------------------------------------------------------------\r\n188: bootsync_sh = \"\"\"#!/bin/sh\r\n189: # Endroid OS Bare-Metal Bootsync — Runs at physical boot as root\r\n190: \r\n191: echo \"========================================================\"\r\n192: echo \"  Starting Endroid OS Standalone Bare-Metal Runtime\"\r\n193: echo \"========================================================\"\r\n194: \r\n195: # 1. Critical library symlinks for 64-bit glibc binaries (Node.js, Xorg)\r\n196: mkdir -p /lib64\r\n197: ln -sf /lib/* /lib64/ 2>/dev/null || true\r\n198: \r\n199: # 2. Hardware device discovery\r\n200: mdev -s 2>/dev/null || true\r\n201: \r\n202: # 3. Network auto-configuration (DHCP loopback + all Ethernet/Wi-Fi)\r\n203: ifconfig lo 127.0.0.1 up\r\n204: for iface in $(ls /sys/class/net/ 2>/dev/null); do\r\n205:     if [ \"$iface\" != \"lo\" ]; then\r\n206:         ifconfig \"$iface\" up 2>/dev/null || true\r\n207:         udhcpc -b -i \"$iface\" -s /usr/share/udhcpc/default.script 2>/dev/null || true\r\n208:     fi\r\n209: done\r\n210: \r\n211: # 4. Persistent Data Storage Detection\r\n212: mkdir -p /mnt/endroid_storage\r\n213: PERSIST_DEV=$(blkid -L ENDROID_DATA 2>/dev/null || blkid | grep 'ENDROID_DATA' | cut -d: -f1 | head -n1)\r\n214: if [ -n \"$PERSIST_DEV\" ]; then\r\n215:     echo \"[Endroid OS] Found persistent storage on $PERSIST_DEV, mounting...\"\r\n216:     mount -o rw,noatime \"$PERSIST_DEV\" /mnt/endroid_storage 2>/dev/null || true\r\n217:     if [ -d /mnt/endroid_storage/opt/endroid/vfs ]; then\r\n218:         mount --bind /mnt/endroid_storage/opt/endroid/vfs /opt/endroid/vfs 2>/dev/null || true\r\n219:     fi\r\n220:     if [ -d /mnt/endroid_storage/home/tc ]; then\r\n221:         mount --bind /mnt/endroid_storage/home/tc /home/tc 2>/dev/null || true\r\n222:     fi\r\n223: fi\r\n224: \r\n225: # 5. Setup TCEDIR and wait for TinyCore to load extensions\r\n226: mkdir -p /tmp/tce/optional\r\n227: mkdir -p /etc/sysconfig\r\n228: echo Xorg > /etc/sysconfig/Xserver\r\n229: echo jwm > /etc/sysconfig/desktop\r\n230: ln -sf /tmp/tce /etc/sysconfig/tcedir 2>/dev/null || true\r\n231: \r\n232: # Mount CDROM to find TCZ packages (try multiple device names)\r\n233: mkdir -p /mnt/sr0\r\n234: for dev in /dev/sr0 /dev/sr1 /dev/cdrom /dev/cd0; do\r\n235:     mount -r $dev /mnt/sr0 2>/dev/null && break\r\n236: done\r\n237: \r\n238: # Copy all extensions from CD into TCEDIR\r\n239: for tcedir in /mnt/sr0/cce/optional /mnt/sr0/tce/optional; do\r\n240:     if [ -d \"$tcedir\" ]; then\r\n241:         cp \"$tcedir\"/*.tcz /tmp/tce/optional/ 2>/dev/null || true\r\n242:         cp \"$tcedir\"/*.dep /tmp/tce/optional/ 2>/dev/null || true\r\n243:     fi\r\n244: done\r\n245: \r\n246: # Load complete Xorg and Desktop stack\r\n247: for pkg in Xorg-jwm-desktop.tcz Xorg-7.7-bin.tcz Xprogs.tcz vesa-Xorg.conf.tcz dillo.tcz; do\r\n248:     [ -f /tmp/tce/optional/$pkg ] && tce-load -i /tmp/tce/optional/$pkg 2>/dev/null || true\r\n249: done\r\n250: \r\n251: # NOTE: GUI is started from bootlocal.sh AFTER TinyCore loads TCE extensions\r\n252: # bootlocal.sh runs after all onboot.lst packages are installed\r\n253: \"\"\"\r\n254: add_text('opt/bootsync.sh', bootsync_sh, 0o100755)\r\n255: \r\n256: bootlocal_sh = \"\"\"#!/bin/sh\r\n257: # Endroid OS bootlocal — runs AFTER all TCE extensions are loaded\r\n258: \r\n259: # Fix lib64 for 64-bit binaries\r\n260: mkdir -p /lib64\r\n261: ln -sf /lib/* /lib64/ 2>/dev/null || true\r\n262: \r\n263: # Start Endroid Node.js server\r\n264: if ! pgrep -f \"node.*index.js\" >/dev/null 2>&1; then\r\n265:     export PORT=8080\r\n266:     /usr/local/bin/node /opt/endroid/server/index.js > /var/log/endroid.log 2>&1 &\r\n267: fi\r\n268: \r\n269: # Prepare user desktop session\r\n270: mkdir -p /home/tc\r\n271: cat > /home/tc/.xinitrc <<'XIEOF'\r\n272: #!/bin/sh\r\n273: dillo http://127.0.0.1:8080/ &\r\n274: jwm\r\n275: XIEOF\r\n276: chmod +x /home/tc/.xinitrc\r\n277: chown -R tc:staff /home/tc 2>/dev/null || true\r\n278: \r\n279: # Start graphical environment (runs after all TCE packages loaded)\r\n280: if which startx >/dev/null 2>&1; then\r\n281:     su tc -c 'startx' >/dev/null 2>&1 &\r\n282: elif which xinit >/dev/null 2>&1; then\r\n283:     su tc -c 'xinit /home/tc/.xinitrc -- :0 vt7' >/dev/null 2>&1 &\r\n284: else\r\n285:     Xorg :0 vt7 -nolisten tcp >/dev/null 2>&1 &\r\n286:     sleep 3\r\n287:     DISPLAY=:0 jwm >/dev/null 2>&1 &\r\n288:     DISPLAY=:0 dillo http://127.0.0.1:8080/ >/dev/null 2>&1 &\r\n289: fi\r\n290: \"\"\"\r\n291: add_text('opt/bootlocal.sh', bootlocal_sh, 0o100755)\r\n292: \r\n293: # MOTD\r\n294: motd = \"\"\"\r\n295: =============================================================\r\n296:   Endroid OS — Standalone Bare-Metal Operating System\r\n297:   Kernel: $(uname -r) | Arch: $(uname -m)\r\n298:   Web Desktop: http://127.0.0.1:8080/\r\n299: =============================================================\r\n300: \"\"\"\r\n301: add_text('etc/motd', motd, 0o100644)\r\n302: \r\n303: # Copy all cached TCE packages into ISO /cce/optional/\r\n304: if os.path.exists(TCE_CACHE):\r\n305:     tce_files = os.listdir(TCE_CACHE)\r\n306:     for tf in tce_files:\r\n307:         src = os.path.join(TCE_CACHE, tf)\r\n308:         dest = os.path.join(STAGING_DIR, 'cce', 'optional', tf)\r\n309:         shutil.copy2(src, dest)\r\n310: \r\n311: # Onboot package list for TinyCore\r\n312: onboot_lst = \"\"\"Xorg-jwm-desktop.tcz\r\n313: vesa-Xorg.conf.tcz\r\n314: dillo.tcz\r\n315: \"\"\"\r\n316: with open(os.path.join(STAGING_DIR, 'cce', 'onboot.lst'), 'w', newline='\\n') as f:\r\n317:     f.write(onboot_lst)\r\n318: \r\n319: # CPIO trailer and compression\r\n320: new_cpio.write(make_cpio_entry('TRAILER!!!', b''))\r\n321: print(\"[3/5] Compressing bare-metal initrd.gz...\")\r\n322: initrd_path = os.path.join(STAGING_DIR, 'isolinux', 'initrd.gz')\r\n323: with gzip.open(initrd_path, 'wb', compresslevel=6) as gz:\r\n324:     gz.write(new_cpio.getvalue())\r\n325: print(f\"  initrd.gz size: {os.path.getsize(initrd_path)/1024/1024:.2f} MB\")\r\n326: \r\n327: # Copy initrd.gz and vmlinuz to boot/\r\n328: shutil.copy2(initrd_path, os.path.join(STAGING_DIR, 'boot', 'initrd.gz'))\r\n329: shutil.copy2(os.path.join(KERNEL_ASSETS, 'vmlinuz64'), os.path.join(STAGING_DIR, 'boot', 'vmlinuz'))\r\n330: \r\n331: # ---------------------------------------------------------------\r\n332: # STEP 4: Stage Dual Bootloaders (BIOS ISOLINUX + UEFI Syslinux/GRUB)\r\n333: # ---------------------------------------------------------------\r\n334: print(\"[4/5] Staging Dual Bootloaders (UEFI 64-bit + BIOS ISOLINUX)...\")\r\n335: \r\n336: # BIOS ISOLINUX\r\n337: shutil.copy2(os.path.join(KERNEL_ASSETS, 'vmlinuz64'), os.path.join(STAGING_DIR, 'isolinux', 'vmlinuz'))\r\n338: shutil.copy2(os.path.join(ISOLINUX_BINS, 'isolinux.bin'), os.path.join(STAGING_DIR, 'isolinux', 'isolinux.bin'))\r\n339: shutil.copy2(os.path.join(ISOLINUX_BINS, 'ldlinux.c32'), os.path.join(STAGING_DIR, 'isolinux', 'ldlinux.c32'))\r\n340: \r\n341: isolinux_cfg = \"\"\"\\\r\n342: DEFAULT endroid\r\n343: PROMPT 0\r\n344: TIMEOUT 30\r\n345: \r\n346: LABEL endroid\r\n347:   LINUX /boot/vmlinuz\r\n348:   INITRD /boot/initrd.gz\r\n349:   APPEND quiet loglevel=3 waitusb=5 cce=cce\r\n350: \"\"\"\r\n351: with open(os.path.join(STAGING_DIR, 'isolinux', 'isolinux.cfg'), 'w', newline='\\n') as f:\r\n352:     f.write(isolinux_cfg)\r\n353: \r\n354: # UEFI EFI/BOOT/\r\n355: syslinux_zip = os.path.join(KERNEL_ASSETS, 'syslinux.zip')\r\n356: if os.path.exists(syslinux_zip):\r\n357:     with zipfile.ZipFile(syslinux_zip, 'r') as zf:\r\n358:         efi_extracts = {\r\n359:             'efi64/efi/syslinux.efi': 'BOOTX64.EFI',\r\n360:             'efi64/com32/elflink/ldlinux/ldlinux.e64': 'ldlinux.e64',\r\n361:             'efi64/com32/modules/linux.c32': 'linux.c32',\r\n362:             'efi64/com32/modules/libutil.c32': 'libutil.c32',\r\n363:             'efi64/com32/modules/libcom32.c32': 'libcom32.c32'\r\n364:         }\r\n365:         for zip_path, out_name in efi_extracts.items():\r\n366:             if zip_path in zf.namelist():\r\n367:                 out_path = os.path.join(STAGING_DIR, 'EFI', 'BOOT', out_name)\r\n368:                 with open(out_path, 'wb') as of:\r\n369:                     of.write(zf.read(zip_path))\r\n370:                 print(f\"  Extracted UEFI component: {out_name}\")\r\n371: \r\n372: efi_cfg = \"\"\"\\\r\n373: DEFAULT endroid\r\n374: PROMPT 0\r\n375: TIMEOUT 30\r\n376: \r\n377: LABEL endroid\r\n378:   LINUX /boot/vmlinuz\r\n379:   INITRD /boot/initrd.gz\r\n380:   APPEND quiet loglevel=3 waitusb=5 cce=cce\r\n381: \"\"\"\r\n382: with open(os.path.join(STAGING_DIR, 'EFI', 'BOOT', 'syslinux.cfg'), 'w', newline='\\n') as f:\r\n383:     f.write(efi_cfg)\r\n384: \r\n385: # GRUB2 config fallback for UEFI\r\n386: grub_cfg = \"\"\"\\\r\n387: set default=0\r\n388: set timeout=3\r\n389: \r\n390: menuentry \"Endroid OS (Standalone Bare-Metal)\" {\r\n391:     linux /boot/vmlinuz quiet loglevel=3 waitusb=5 cce=cce\r\n392:     initrd /boot/initrd.gz\r\n393: }\r\n394: \"\"\"\r\n395: with open(os.path.join(STAGING_DIR, 'EFI', 'BOOT', 'grub.cfg'), 'w', newline='\\n') as f:\r\n396:     f.write(grub_cfg)\r\n397: \r\n398: # ---------------------------------------------------------------\r\n399: # STEP 5: Assemble Bootable Hybrid ISO9660\r\n400: # ---------------------------------------------------------------\r\n401: print(\"[5/5] Assembling bootable ISO9660...\")\r\n402: import pycdlib\r\n403: \r\n404: iso = pycdlib.PyCdlib()\r\n405: iso.new(interchange_level=3, joliet=3, rock_ridge='1.09', vol_ident='ENDROID_OS')\r\n406: \r\n407: def make_iso_8_3(fname):\r\n408:     parts = fname.rsplit('.', 1)\r\n409:     if len(parts) == 2:\r\n410:         base = parts[0].replace('.', '_').replace('-', '_').upper()[:8]\r\n411:         ext = parts[1].replace('.', '_').replace('-', '_').upper()[:3]\r\n412:         return f\"{base}.{ext}\"\r\n413:     else:\r\n414:         base = fname.replace('.', '_').replace('-', '_').upper()[:8]\r\n415:         return base\r\n416: \r\n417: # Add ISOLINUX (BIOS)\r\n418: iso.add_directory('/ISOLINUX', rr_name='isolinux', joliet_path='/isolinux')\r\n419: iso.add_file(os.path.join(STAGING_DIR, 'isolinux', 'isolinux.bin'), '/ISOLINUX/ISOLINUX.BIN;1', rr_name='isolinux.bin', joliet_path='/isolinux/isolinux.bin')\r\n420: \r\n421: # El Torito BIOS boot catalog\r\n422: iso.add_eltorito(\r\n423:     '/ISOLINUX/ISOLINUX.BIN;1',\r\n424:     bootcatfile='/ISOLINUX/BOOT.CAT;1',\r\n425:     rr_bootcatname='boot.cat',\r\n426:     joliet_bootcatfile='/isolinux/boot.cat',\r\n427:     boot_load_size=4,\r\n428:     media_name='noemul',\r\n429:     boot_info_table=True\r\n430: )\r\n431: \r\n432: iso.add_file(os.path.join(STAGING_DIR, 'isolinux', 'ldlinux.c32'), '/ISOLINUX/LDLINUX.C32;1', rr_name='ldlinux.c32', joliet_path='/isolinux/ldlinux.c32')\r\n433: iso.add_file(os.path.join(STAGING_DIR, 'isolinux', 'isolinux.cfg'), '/ISOLINUX/ISOLINUX.CFG;1', rr_name='isolinux.cfg', joliet_path='/isolinux/isolinux.cfg')\r\n434: \r\n435: # Add /boot\r\n436: iso.add_directory('/BOOT', rr_name='boot', joliet_path='/boot')\r\n437: iso.add_file(os.path.join(STAGING_DIR, 'boot', 'vmlinuz'), '/BOOT/VMLINUZ;1', rr_name='vmlinuz', joliet_path='/boot/vmlinuz')\r\n438: iso.add_file(os.path.join(STAGING_DIR, 'boot', 'initrd.gz'), '/BOOT/INITRD.GZ;1', rr_name='initrd.gz', joliet_path='/boot/initrd.gz')\r\n439: \r\n440: # Add /EFI/BOOT (UEFI)\r\n441: iso.add_directory('/EFI', rr_name='EFI', joliet_path='/EFI')\r\n442: iso.add_directory('/EFI/BOOT', rr_name='BOOT', joliet_path='/EFI/BOOT')\r\n443: efi_boot_files = os.listdir(os.path.join(STAGING_DIR, 'EFI', 'BOOT'))\r\n444: for ebf in efi_boot_files:\r\n445:     fpath = os.path.join(STAGING_DIR, 'EFI', 'BOOT', ebf)\r\n446:     iso_name = make_iso_8_3(ebf)\r\n447:     iso.add_file(fpath, f'/EFI/BOOT/{iso_name};1', rr_name=ebf, joliet_path=f'/EFI/BOOT/{ebf}')\r\n448: \r\n449: # Add /cce and /cce/optional with all TCZ packages\r\n450: iso.add_directory('/CCE', rr_name='cce', joliet_path='/cce')\r\n451: iso.add_file(os.path.join(STAGING_DIR, 'cce', 'onboot.lst'), '/CCE/ONBOOT.LST;1', rr_name='onboot.lst', joliet_path='/cce/onboot