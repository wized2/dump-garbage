=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><rect width=%2224%22 height=%2224%22 rx=%226%22 fill=%22%2314B8A6%22/></svg>\">\n8: <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n9: <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n10: <script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.js\"></script>\n11: <script src=\"https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js\"></script>\n12: <style>\n13: :root{\n14:   --bg-0:#0B0D11;\n15:   --bg-1:#12151B;\n16:   --bg-2:#1A1E26;\n17:   --bg-3:#232833;\n18:   --line:#2A2F3A;\n19:   --line-soft:#1E222B;\n20:   --text-0:#EDEFF3;\n21:   --text-1:#A8AFBD;\n22:   --text-2:#6B7280;\n23:   --accent:#4FD1C5;\n24:   --accent-dim:#2C8A80;\n25:   --accent-glow:rgba(79,209,197,0.18);\n26:   --warn:#E8A33D;\n27:   --danger:#E8615C;\n28:   --radius:12px;\n29:   --font-display:'Space Grotesk',sans-serif;\n30:   --font-body:'Inter',sans-serif;\n31:   --font-mono:'JetBrains Mono',monospace;\n32: }\n33: [data-theme=\"light\"]{\n34:   --bg-0:#EEF0F3;\n35:   --bg-1:#F7F8FA;\n36:   --bg-2:#FFFFFF;\n37:   --bg-3:#FFFFFF;\n38:   --line:#DBDEE4;\n39:   --line-soft:#E6E8EC;\n40:   --text-0:#161A20;\n41:   --text-1:#565E6B;\n42:   --text-2:#8A909C;\n43:   --accent:#0F9E90;\n44:   --accent-dim:#0C7F74;\n45:   --accent-glow:rgba(15,158,144,0.14);\n46: }\n47: *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n48: html,body{margin:0;padding:0;height:100%;overflow:hidden;}\n49: body{\n50:   font-family:var(--font-body);\n51:   background:var(--bg-0);\n52:   color:var(--text-0);\n53:   -webkit-font-smoothing:antialiased;\n54: }\n55: @media (prefers-reduced-motion: reduce){\n56:   *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}\n57: }\n58: ::selection{background:var(--accent-glow);color:var(--text-0);}\n59: ::-webkit-scrollbar{width:10px;height:10px;}\n60: ::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px;}\n61: ::-webkit-scrollbar-track{background:transparent;}\n62: \n63: /* ---------- BOOT SCREEN ---------- */\n64: #boot{\n65:   position:fixed;inset:0;z-index:9999;\n66:   background:var(--bg-0);\n67:   display:flex;flex-direction:column;align-items:center;justify-content:center;\n68:   transition:opacity .6s ease;\n69: }\n70: #boot.hide{opacity:0;pointer-events:none;}\n71: .boot-mark{\n72:   width:56px;height:56px;border-radius:14px;\n73:   background:linear-gradient(145deg,var(--accent),var(--accent-dim));\n74:   display:flex;align-items:center;justify-content:center;\n75:   box-shadow:0 0 60px var(--accent-glow);\n76:   margin-bottom:22px;\n77:   animation:pulse 2s ease-in-out infinite;\n78: }\n79: @keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.06);}}\n80: .boot-mark svg{width:30px;height:30px;color:#08110F;}\n81: .boot-title{font-family:var(--font-display);font-weight:600;font-size:20px;letter-spacing:0.5px;margin-bottom:2px;}\n82: .boot-sub{font-family:var(--font-mono);font-size:11px;color:var(--text-2);margin-bottom:28px;letter-spacing:1px;}\n83: .boot-bar{width:220px;height:3px;background:var(--line-soft);border-radius:3px;overflow:hidden;}\n84: .boot-bar-fill{height:100%;width:0%;background:var(--accent);border-radius:3px;transition:width .25s ease;}\n85: .boot-log{font-family:var(--font-mono);font-size:10.5px;color:var(--text-2);margin-top:16px;height:16px;letter-spacing:0.3px;}\n86: \n87: /* ---------- DESKTOP ---------- */\n88: #desktop{\n89:   position:fixed;inset:0;\n90:   background:\n91:     radial-gradient(circle at 15% 12%, rgba(79,209,197,0.10), transparent 40%),\n92:     radial-gradient(circle at 85% 88%, rgba(79,209,197,0.06), transparent 45%),\n93:     var(--bg-0);\n94:   display:none;\n95:   user-select:none;\n96: }\n97: #desktop.active{display:block;}\n98: #desktop-icons{\n99:   position:absolute;top:20px;left:16px;\n100:   display:grid;grid-template-columns:repeat(1,76px);gap:6px;\n101: }\n102: .d-icon{\n103:   width:76px;padding:10px 4px 8px;border-radius:10px;\n104:   display:flex;flex-direction:column;align-items:center;gap:6px;\n105:   cursor:pointer;text-align:center;\n106: }\n107: .d-icon:hover{background:rgba(255,255,255,0.05);}\n108: [data-theme=\"light\"] .d-icon:hover{background:rgba(0,0,0,0.05);}\n109: .d-icon .ico{\n110:   width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;\n111:   background:var(--bg-2);border:1px solid var(--line-soft);\n112: }\n113: .d-icon .ico svg{width:20px;height:20px;stroke:var(--accent);}\n114: .d-icon span{font-size:11px;color:var(--text-0);line-height:1.2;text-shadow:0 1px 2px rgba(0,0,0,0.4);}\n115: \n116: /* ---------- WINDOWS ---------- */\n117: .window{\n118:   position:absolute;\n119:   background:var(--bg-1);\n120:   border:1px solid var(--line);\n121:   border-radius:var(--radius);\n122:   box-shadow:0 24px 60px rgba(0,0,0,0.45), 0 2px 10px rgba(0,0,0,0.3);\n123:   display:flex;flex-direction:column;\n124:   overflow:hidden;\n125:   min-width:320px;min-height:220px;\n126:   animation:winIn .22s cubic-bezier(.2,.9,.3,1);\n127: }\n128: @keyframes winIn{from{opacity:0;transform:scale(.96) translateY(8px);}to{opacity:1;transform:scale(1) translateY(0);}}\n129: .window.focused{border-color:var(--accent-dim);box-shadow:0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px var(--accent-glow);}\n130: .window.closing{animation:winOut .16s ease forwards;}\n131: @keyframes winOut{to{opacity:0;transform:scale(.96);}}\n132: .win-titlebar{\n133:   height:42px;flex:0 0 auto;\n134:   display:flex;align-items:center;\n135:   padding:0 8px 0 14px;\n136:   background:var(--bg-2);\n137:   border-bottom:1px solid var(--line-soft);\n138:   cursor:grab;gap:10px;\n139: }\n140: .win-titlebar:active{cursor:grabbing;}\n141: .win-titlebar .win-ico{width:16px;height:16px;stroke:var(--accent);flex:0 0 auto;}\n142: .win-titlebar .win-title{font-size:13px;font-weight:500;color:var(--text-0);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}\n143: .win-controls{display:flex;gap:6px;}\n144: .win-btn{\n145:   width:26px;height:26px;border-radius:7px;border:none;background:transparent;\n146:   display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-1);\n147: }\n148: .win-btn:hover{background:var(--bg-3);color:var(--text-0);}\n149: .win-btn.close:hover{background:var(--danger);color:#fff;}\n150: .win-btn svg{width:14px;height:14px;}\n151: .win-body{flex:1;overflow:auto;position:relative;background:var(--bg-1);}\n152: .resize-handle{position:absolute;right:0;bottom:0;width:16px;height:16px;cursor:nwse-resize;z-index:5;}\n153: \n154: /* ---------- TASKBAR ---------- */\n155: #taskbar{\n156:   position:absolute;left:0;right:0;bottom:0;height:56px;\n157:   background:rgba(18,21,27,0.82);\n158:   backdrop-filter:blur(18px) saturate(1.4);\n159:   border-top:1px solid var(--line);\n160:   display:flex;align-items:center;\n161:   padding:0 10px;gap:8px;\n162:   z-index:1000;\n163: }\n164: [data-theme=\"light\"] #taskbar{background:rgba(247,248,250,0.85);}\n165: #launcher-btn{\n166:   width:38px;height:38px;border-radius:10px;border:none;cursor:pointer;\n167:   background:linear-gradient(145deg,var(--accent),var(--accent-dim));\n168:   display:flex;align-items:center;justify-content:center;flex:0 0 auto;\n169: }\n170: #launcher-btn svg{width:19px;height:19px;stroke:#08110F;}\n171: #launcher-btn:hover{filter:brightness(1.08);}\n172: #taskbar-sep{width:1px;height:26px;background:var(--line);flex:0 0 auto;}\n173: #pinned-apps{display:flex;gap:4px;flex:0 0 auto;}\n174: #running-apps{display:flex;gap:4px;flex:1;overflow-x:auto;scrollbar-width:none;}\n175: #running-apps::-webkit-scrollbar{display:none;}\n176: .taskbar-app{\n177:   height:38px;padding:0 10px;border-radius:9px;border:none;background:transparent;\n178:   display:flex;align-items:center;gap:7px;cursor:pointer;color:var(--text-1);\n179:   position:relative;min-width:38px;flex:0 0 auto;\n180: }\n181: .taskbar-app svg{width:17px;height:17px;stroke:currentColor;flex:0 0 auto;}\n182: .taskbar-app span{font-size:12.5px;white-space:nowrap;color:var(--text-0);max-width:110px;overflow:hidden;text-overflow:ellipsis;}\n183: .taskbar-app:hover{background:var(--bg-3);}\n184: .taskbar-app.active{background:var(--bg-3);color:var(--accent);}\n185: .taskbar-app.active svg{stroke:var(--accent);}\n186: .taskbar-app.running::after{\n187:   content:'';position:absolute;bottom:2px;left:50%;transform:translateX(-50%);\n188:   width:4px;height:4px;border-radius:50%;background:var(--accent);\n189: }\n190: #systray{display:flex;align-items:center;gap:4px;flex:0 0 auto;}\n191: .tray-btn{\n192:   height:38px;padding:0 9px;border-radius:9px;border:none;background:transparent;\n193:   display:flex;align-items:center;gap:6px;cursor:pointer;color:var(--text-1);position:relative;\n194: }\n195: .tray-btn:hover{background:var(--bg-3);color:var(--text-0);}\n196: .tray-btn svg{width:16px;height:16px;}\n197: #clock-box{display:flex;flex-direction:column;align-items:flex-end;line-height:1.15;padding:0 4px;}\n198: #clock-time{font-family:var(--font-mono);font-size:12.5px;color:var(--text-0);}\n199: #clock-date{font-size:10px;color:var(--text-2);}\n200: .notif-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;border-radius:50%;background:var(--accent);border:2px solid var(--bg-1);}\n201: \n202: /* ---------- LAUNCHER ---------- */\n203: #launcher{\n204:   position:absolute;left:10px;bottom:66px;width:360px;max-height:70vh;\n205:   background:var(--bg-2);border:1px solid var(--line);border-radius:16px;\n206:   box-shadow:0 30px 70px rgba(0,0,0,0.5);\n207:   display:none;flex-direction:column;overflow:hidden;z-index:1100;\n208:   animation:popUp .18s cubic-bezier(.2,.9,.3,1);\n209: }\n210: #launcher.active{display:flex;}\n211: @keyframes popUp{from{opacity:0;transform:translateY(10px) scale(.98);}to{opacity:1;transform:translateY(0) scale(1);}}\n212: #launcher-search{\n213:   margin:12px;padding:10px 12px;border-radius:10px;background:var(--bg-3);\n214:   border:1px solid var(--line-soft);display:flex;align-items:center;gap:8px;\n215: }\n216: #launcher-search svg{width:15px;height:15px;stroke:var(--text-2);flex:0 0 auto;}\n217: #launcher-search input{\n218:   border:none;background:transparent;outline:none;color:var(--text-0);font-size:13px;width:100%;font-family:var(--font-body);\n219: }\n220: #launcher-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding:4px 8px 14px;overflow-y:auto;}\n221: .l-app{\n222:   display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 4px;border-radius:10px;cursor:pointer;\n223: }\n224: .l-app:hover{background:var(--bg-3);}\n225: .l-app .ico{width:42px;height:42px;border-radius:11px;background:var(--bg-1);border:1px solid var(--line-soft);display:flex;align-items:center;justify-content:center;}\n226: .l-app .ico svg{width:19px;height:19px;stroke:var(--accent);}\n227: .l-app span{font-size:10.5px;color:var(--text-1);text-align:center;line-height:1.2;}\n228: \n229: /* ---------- NOTIFICATION CENTER ---------- */\n230: #notif-center{\n231:   position:absolute;right:10px;bottom:66px;width:320px;max-height:60vh;\n232:   background:var(--bg-2);border:1px solid var(--line);border-radius:16px;\n233:   box-shadow:0 30px 70px rgba(0,0,0,0.5);\n234:   display:none;flex-direction:column;overflow:hidden;z-index:1100;\n235: }\n236: #notif-center.active{display:flex;animation:popUp .18s cubic-bezier(.2,.9,.3,1);}\n237: .nc-head{display:flex;align-items:center;justify-content:space-between;padding:14px 14px 8px;}\n238: .nc-head span{font-family:var(--font-display);font-weight:600;font-size:13px;}\n239: .nc-head button{background:none;border:none;color:var(--accent);font-size:11.5px;cursor:pointer;font-family:var(--font-body);}\n240: #nc-list{overflow-y:auto;padding:4px 10px 12px;display:flex;flex-direction:column;gap:6px;}\n241: .nc-item{background:var(--bg-3);border-radius:10px;padding:10px 12px;display:flex;gap:10px;}\n242: .nc-item svg{width:16px;height:16px;stroke:var(--accent);flex:0 0 auto;margin-top:1px;}\n243: .nc-item .t{font-size:12px;font-weight:600;color:var(--text-0);}\n244: .nc-item .d{font-size:11px;color:var(--text-2);margin-top:2px;}\n245: .nc-empty{padding:30px 14px;text-align:center;color:var(--text-2);font-size:12px;}\n246: \n247: /* ---------- TOASTS ---------- */\n248: #toasts{position:absolute;top:16px;right:16px;display:flex;flex-direction:column;gap:8px;z-index:1200;}\n249: .toast{\n250:   background:var(--bg-2);border:1px solid var(--line);border-radius:11px;\n251:   padding:11px 14px;display:flex;gap:10px;align-items:flex-start;width:280px;\n252:   box-shadow:0 14px 34px rgba(0,0,0,0.4);\n253:   animation:toastIn .25s cubic-bezier(.2,.9,.3,1);\n254: }\n255: @keyframes toastIn{from{opacity:0;transform:translateX(30px);}to{opacity:1;transform:translateX(0);}}\n256: .toast.out{animation:toastOut .2s ease forwards;}\n257: @keyframes toastOut{to{opacity:0;transform:translateX(30px);}}\n258: .toast svg{width:17px;height:17px;stroke:var(--accent);flex:0 0 auto;margin-top:1px;}\n259: .toast .t{font-size:12.5px;font-weight:600;color:var(--text-0);}\n260: .toast .d{font-size:11.5px;color:var(--text-2);margin-top:1px;}\n261: \n262: /* ---------- CONTEXT MENU ---------- */\n263: #ctx-menu{\n264:   position:absolute;background:var(--bg-2);border:1px solid var(--line);border-radius:10px;\n265:   box-shadow:0 20px 50px rgba(0,0,0,0.5);padding:6px;display:none;z-index:1300;min-width:180px;\n266: }\n267: #ctx-menu.active{display:block;}\n268: .ctx-item{\n269:   display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:7px;font-size:12.5px;color:var(--text-0);cursor:pointer;\n270: }\n271: .ctx-item:hover{background:var(--bg-3);}\n272: .ctx-item svg{width:14px;height:14px;stroke:var(--text-1);}\n273: .ctx-sep{height:1px;background:var(--line-soft);margin:5px 4px;}\n274: \n275: /* ---------- GENERIC APP UI ---------- */\n276: .app-pane{height:100%;display:flex;flex-direction:column;font-size:13px;}\n277: .app-toolbar{\n278:   display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid var(--line-soft);flex:0 0 auto;background:var(--bg-1);\n279: }\n280: .app-toolbar button{\n281:   background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;color:var(--text-1);\n282:   width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;\n283: }\n284: .app-toolbar button:hover{color:var(--text-0);border-color:var(--line);}\n285: .app-toolbar button svg{width:14px;height:14px;}\n286: .app-toolbar .path{font-family:var(--font-mono);font-size:11.5px;color:var(--text-1);flex:1;background:var(--bg-3);padding:7px 10px;border-radius:8px;border:1px solid var(--line-soft);}\n287: .split{display:flex;height:100%;}\n288: .sidebar{width:150px;flex:0 0 auto;border-right:1px solid var(--line-soft);padding:10px 6px;overflow-y:auto;background:var(--bg-1);}\n289: .side-item{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:8px;font-size:12.5px;color:var(--text-1);cursor:pointer;}\n290: .side-item svg{width:14px;height:14px;}\n291: .side-item:hover{background:var(--bg-3);color:var(--text-0);}\n292: .side-item.active{background:var(--accent-glow);color:var(--accent);}\n293: .content{flex:1;overflow-y:auto;padding:14px;}\n294: \n295: /* File manager grid */\n296: .fm-grid{display:grid;grid-template-columns:repeat(auto-fill,84px);gap:4px;}\n297: .fm-item{display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 6px;border-radius:9px;cursor:pointer;text-align:center;}\n298: .fm-item:hover{background:var(--bg-3);}\n299: .fm-item.selected{background:var(--accent-glow);outline:1px solid var(--accent-dim);}\n300: .fm-item .ico{width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:var(--bg-2);border:1px solid var(--line-soft);}\n301: .fm-item .ico svg{width:19px;height:19px;}\n302: .fm-item span{font-size:11px;color:var(--text-0);word-break:break-word;line-height:1.2;}\n303: \n304: /* Notes */\n305: .notes-split{display:flex;height:100%;}\n306: .notes-list{width:190px;border-right:1px solid var(--line-soft);overflow-y:auto;flex:0 0 auto;}\n307: .note-row{padding:11px 13px;border-bottom:1px solid var(--line-soft);cursor:pointer;}\n308: .note-row:hover{background:var(--bg-3);}\n309: .note-row.active{background:var(--accent-glow);}\n310: .note-row .nt{font-size:12.5px;font-weight:600;color:var(--text-0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n311: .note-row .np{font-size:11px;color:var(--text-2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n312: .note-edit{flex:1;display:flex;flex-direction:column;}\n313: .note-edit input{border:none;background:transparent;outline:none;font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--text-0);padding:16px 18px 6px;}\n314: .note-edit textarea{flex:1;border:none;background:transparent;outline:none;resize:none;color:var(--text-1);font-size:13.5px;line-height:1.6;padding:0 18px 18px;font-family:var(--font-body);}\n315: \n316: /* Calculator */\n317: .calc{height:100%;display:flex;flex-direction:column;background:var(--bg-1);}\n318: .calc-hist{padding:10px 16px 0;font-family:var(--font-mono);font-size:11px;color:var(--text-2);height:16px;text-align:right;}\n319: .calc-disp{padding:6px 16px 16px;font-family:var(--font-mono);font-size:32px;text-align:right;color:var(--text-0);overflow-x:auto;white-space:nowrap;}\n320: .calc-grid{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line-soft);}\n321: .calc-btn{border:none;background:var(--bg-1);color:var(--text-0);font-size:16px;cursor:pointer;font-family:var(--font-body);}\n322: .calc-btn:hover{background:var(--bg-3);}\n323: .calc-btn.op{color:var(--accent);}\n324: .calc-btn.eq{background:var(--accent);color:#08110F;font-weight:600;}\n325: .calc-btn.eq:hover{filter:brightness(1.08);}\n326: .calc-btn.fn{color:var(--text-1);font-size:13px;}\n327: \n328: /* Terminal */\n329: .term{height:100%;background:#0A0C0F;padding:12px 14px;font-family:var(--font-mono);font-size:12.5px;color:#C8E8E2;overflow-y:auto;}\n330: .term-line{white-space:pre-wrap;line-height:1.6;word-break:break-all;}\n331: .term-prompt{color:var(--accent);}\n332: .term-input-row{display:flex;gap:6px;}\n333: .term-input-row input{flex:1;background:transparent;border:none;outline:none;color:#EDEFF3;font-family:var(--font-mono);font-size:12.5px;}\n334: \n335: /* Settings */\n336: .settings-content{padding:20px;max-width:520px;}\n337: .set-section{margin-bottom:26px;}\n338: .set-h{font-family:var(--font-display);font-weight:600;font-size:13px;color:var(--text-0);margin-bottom:10px;display:flex;align-items:center;gap:8px;}\n339: .set-h svg{width:15px;height:15px;stroke:var(--accent);}\n340: .set-row{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:10px;margin-bottom:6px;}\n341: .set-row .lbl{font-size:12.5px;color:var(--text-0);}\n342: .set-row .sub{font-size:11px;color:var(--text-2);margin-top:2px;}\n343: .swatch-row{display:flex;gap:8px;}\n344: .swatch{width:26px;height:26px;border-radius:50%;cursor:pointer;border:2px solid transparent;}\n345: .swatch.active{border-color:var(--text-0);}\n346: .toggle{width:40px;height:22px;border-radius:12px;background:var(--bg-3);border:1px solid var(--line);position:relative;cursor:pointer;flex:0 0 auto;}\n347: .toggle .knob{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:var(--text-2);transition:.2s;}\n348: .toggle.on{background:var(--accent-glow);border-color:var(--accent-dim);}\n349: .toggle.on .knob{left:20px;background:var(--accent);}\n350: .seg{display:flex;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:9px;padding:3px;gap:2px;}\n351: .seg button{flex:1;border:none;background:transparent;color:var(--text-1);font-size:12px;padding:7px 0;border-radius:6px;cursor:pointer;font-family:var(--font-body);}\n352: .seg button.active{background:var(--bg-3);color:var(--text-0);}\n353: \n354: /* Installer */\n355: .installer-drop{margin:20px;border:1.5px dashed var(--line);border-radius:14px;padding:36px 20px;text-align:center;color:var(--text-1);}\n356: .installer-drop svg{width:30px;height:30px;stroke:var(--accent);margin-bottom:10px;}\n357: .installer-drop .h{font-size:13px;font-weight:600;color:var(--text-0);margin-bottom:4px;}\n358: .installer-drop .s{font-size:11.5px;color:var(--text-2);}\n359: .installer-drop button{margin-top:14px;background:var(--accent);color:#08110F;border:none;border-radius:8px;padding:8px 16px;font-size:12.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);}\n360: .manifest-box{margin:0 20px 20px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:10px;padding:14px;font-family:var(--font-mono);font-size:11.5px;color:var(--text-1);white-space:pre-wrap;}\n361: .installed-list{margin:0 20px 20px;display:flex;flex-direction:column;gap:6px;}\n362: .installed-row{display:flex;align-items:center;gap:10px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:10px;padding:10px 12px;}\n363: .installed-row .ico{width:32px;height:32px;border-radius:8px;background:var(--bg-1);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n364: .installed-row .ico svg{width:15px;height:15px;stroke:var(--accent);}\n365: .installed-row .info{flex:1;}\n366: .installed-row .info .n{font-size:12.5px;font-weight:600;color:var(--text-0);}\n367: .installed-row .info .v{font-size:10.5px;color:var(--text-2);}\n368: \n369: /* Browser */\n370: .browser-bar{display:flex;gap:8px;padding:9px 12px;border-bottom:1px solid var(--line-soft);align-items:center;}\n371: .browser-bar input{flex:1;background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;padding:7px 12px;color:var(--text-0);font-size:12.5px;outline:none;}\n372: .browser-home{padding:40px 30px;text-align:center;}\n373: .browser-home svg{width:34px;height:34px;stroke:var(--accent);margin-bottom:12px;}\n374: .browser-home h2{font-family:var(--font-display);margin:0 0 6px;}\n375: .browser-home p{color:var(--text-2);font-size:12.5px;margin:0 0 20px;}\n376: .bh-grid{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}\n377: .bh-card{background:var(--bg-2);border:1px solid var(--line-soft);border-radius:11px;padding:14px;width:110px;cursor:pointer;}\n378: .bh-card:hover{border-color:var(--accent-dim);}\n379: .bh-card svg{width:18px;height:18px;stroke:var(--accent);margin-bottom:6px;}\n380: .bh-card span{font-size:11.5px;color:var(--text-0);}\n381: \n382: .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--text-2);gap:8px;}\n383: .empty-state svg{width:28px;height:28px;stroke:var(--text-2);}\n384: .empty-state span{font-size:12.5px;}\n385: </style>\n386: </head>\n387: <body data-theme=\"dark\">\n388: \n389: <!-- BOOT -->\n390: <div id=\"boot\">\n391:   <div class=\"boot-mark\"><i data-lucide=\"box\"></i></div>\n392:   <div class=\"boot-title\">Endroid OS</div>\n393:   <div class=\"boot-sub\">v1.0.0 &middot; WEB RUNTIME</div>\n394:   <div class=\"boot-bar\"><div class=\"boot-bar-fill\" id=\"boot-fill\"></div></div>\n395:   <div class=\"boot-log\" id=\"boot-log\">initializing kernel…</div>\n396: </div>\n397: \n398: <!-- DESKTOP -->\n399: <div id=\"desktop\">\n400:   <div id=\"desktop-icons\"></div>\n401:   <div id=\"windows-layer\"></div>\n402: \n403:   <div id=\"toasts\"></div>\n404: \n405:   <div id=\"launcher\">\n406:     <div id=\"launcher-search\">\n407:       <i data-lucide=\"search\"></i>\n408:       <input type=\"text\" id=\"launcher-input\" placeholder=\"Search apps…\" autocomplete=\"off\">\n409:     </div>\n410:     <div id=\"launcher-grid\"></div>\n411:   </div>\n412: \n413:   <div id=\"notif-center\">\n414:     <div class=\"nc-head\"><span>Notifications</span><button id=\"nc-clear\">Clear all</button></div>\n415:     <div id=\"nc-list\"></div>\n416:   </div>\n417: \n418:   <div id=\"ctx-menu\"></div>\n419: \n420:   <div id=\"taskbar\">\n421:     <button id=\"launcher-btn\" title=\"Launcher\"><i data-lucide=\"layout-grid\"></i></button>\n422:     <div id=\"taskbar-sep\"></div>\n423:     <div id=\"pinned-apps\"></div>\n424:     <div id=\"running-apps\"></div>\n425:     <div id=\"systray\">\n426:       <button class=\"tray-btn\" id=\"wifi-btn\" title=\"Network\"><i data-lucide=\"wifi\"></i></button>\n427:       <button class=\"tray-btn\" id=\"vol-btn\" title=\"Sound\"><i data-lucide=\"volume-2\"></i></button>\n428:       <button class=\"tray-btn\" id=\"notif-btn\" title=\"Notifications\"><i data-lucide=\"bell\"></i></button>\n429:       <button class=\"tray-btn\" id=\"clock-btn\" title=\"Date &amp; time\">\n430:         <div id=\"clock-box\"><span id=\"clock-time\">--:--</span><span id=\"clock-date\">--- --</span></div>\n431:       </button>\n432:     </div>\n433:   </div>\n434: </div>\n435: \n436: <script>\n437: lucide.createIcons();\n438: \n439: /* ============ ICON RESOLUTION (Lucide name OR raw SVG) ============ */\n440: const LUCIDE_NAMES = new Set();\n441: (function buildLucideNames(){\n442:   if(window.lucide && lucide.icons){\n443:     Object.keys(lucide.icons).forEach(k=>{\n444:       const kebab = k.replace(/([a-z0-9])([A-Z])/g,'$1-$2').replace(/([A-Z]+)([A-Z][a-z])/g,'$1-$2').toLowerCase();\n445:       LUCIDE_NAMES.add(kebab);\n446:     });\n447:   }\n448: })();\n449: function resolveIconName(name){\n450:   if(!name) return 'app-window';\n451:   return LUCIDE_NAMES.has(name) ? name : 'app-window';\n452: }\n453: function normalizeSvg(svg){\n454:   return svg.replace(/<svg([^>]*)>/i, (m, attrs)=>{\n455:     let a = attrs.replace(/\\s(width|height)=\"[^\"]*\"/gi,'');\n456:     return `<svg${a} width=\"100%\" height=\"100%\">`;\n457:   });\n458: }\n459: function iconMarkup(app){\n460:   if(app.svg) return `<span style=\"display:flex;align-items:center;justify-content:center;width:100%;height:100%;\">${normalizeSvg(app.svg)}</span>`;\n461:   return `<i data-lucide=\"${app.icon}\"></i>`;\n462: }\n463: \n464: /* ============ APP REGISTRY ============ */\n465: const APPS = {\n466:   files:     { name:\"File Manager\", icon:\"folder\",        pinned:true,  render: renderFiles },\n467:   browser:   { name:\"Browser\",      icon:\"compass\",        pinned:true,  render: renderBrowser },\n468:   notes:     { name:\"Notes\",        icon:\"sticky-note\",    pinned:true,  render: renderNotes },\n469:   calc:      { name:\"Calculator\",   icon:\"calculator\",     pinned:true,  render: renderCalc },\n470:   installer: { name:\"App Installer\",icon:\"package-plus\",   pinned:false, render: renderInstaller },\n471:   terminal:  { name:\"Terminal\",     icon:\"square-terminal\",pinned:true,  render: renderTerminal },\n472:   weather:   { name:\"Weather\",      icon:\"cloud-sun\",      pinned:true,  render: renderWeather },\n473:   facts:     { name:\"Useless Facts\",icon:\"sparkles\",       pinned:false, render: renderFacts },\n474:   currency:  { name:\"Currency\",     icon:\"banknote\",       pinned:false, render: renderCurrency },\n475:   password:  { name:\"Password Gen\", icon:\"key-round\",      pinned:false, render: renderPassword },\n476:   qr:        { name:\"QR Code\",      icon:\"qr-code\",        pinned:false, render: renderQR },\n477:   units:     { name:\"Unit Converter\",icon:\"ruler\",         pinned:false, render: renderUnits },\n478:   gallery:   { name:\"Gallery\",      icon:\"image\",          pinned:false, render: renderGallery },\n479:   music:     { name:\"Music\",        icon:\"music\",          pinned:true,  render: renderMusic },\n480:   calendar:  { name:\"Calendar\",     icon:\"calendar-days\",  pinned:true,  render: renderCalendar },\n481:   contacts:  { name:\"Contacts\",     icon:\"contact-round\",  pinned:false, render: renderContacts },\n482:   settings:  { name:\"Settings\",     icon:\"settings\",       pinned:false, render: renderSettings },\n483: };\n484: \n485: /* ============ STATE ============ */\n486: let zTop = 10;\n487: const openWindows = {}; // id -> {el, appKey, minimized}\n488: let winCount = 0;\n489: \n490: /* ============ BOOT SEQUENCE ============ */\n491: const bootLogs = [\n492:   \"initializing kernel…\",\n493:   \"mounting root filesystem…\",\n494:   \"starting local API server…\",\n495:   \"loading window manager…\",\n496:   \"starting desktop shell…\",\n497:   \"ready.\"\n498: ];\n499: let bStep = 0;\n500: const bootFill = document.getElementById('boot-fill');\n501: const bootLog = document.getElementById('boot-log');\n502: const bootInterval = setInterval(()=>{\n503:   bStep++;\n504:   bootFill.style.width = Math.min(100, (bStep/bootLogs.length)*100) + '%';\n505:   bootLog.textContent = bootLogs[Math.min(bStep, bootLogs.length-1)];\n506:   if(bStep >= bootLogs.length){\n507:     clearInterval(bootInterval);\n508:     setTimeout(()=>{\n509:       document.getElementById('boot').classList.add('hide');\n510:       document.getElementById('desktop').classList.add('active');\n511:       setTimeout(()=>{document.getElementById('boot').style.display='none';}, 650);\n512:       pushNotif('system','box','Welcome to Endroid OS','System booted successfully in 6.2s');\n513:     }, 350);\n514:   }\n515: }, 260);\n516: \n517: /* ============ CLOCK ============ */\n518: function tickClock(){\n519:   const d = new Date();\n520:   document.getElementById('clock-time').textContent = d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});\n521:   document.getElementById('clock-date').textContent = d.toLocaleDateString([], {weekday:'short', month:'short', day:'numeric'});\n522: }\n523: tickClock(); setInterval(tickClock, 1000*15);\n524: \n525: /* ============ DESKTOP ICONS ============ */\n526: const desktopIconKeys = ['files','browser','notes','terminal','weather'];\n527: const diLayer = document.getElementById('desktop-icons');\n528: desktopIconKeys.forEach(k=>{\n529:   const app = APPS[k];\n530:   const el = document.createElement('div');\n531:   el.className='d-icon';\n532:   el.innerHTML = `<div class=\"ico\">${iconMarkup(app)}</div><span>${app.name}</span>`;\n533:   el.ondblclick = ()=>openApp(k);\n534:   el.onclick = (e)=>{e.stopPropagation();};\n535:   diLayer.appendChild(el);\n536: });\n537: \n538: /* ============ TASKBAR: PINNED ============ */\n539: const pinnedLayer = document.getElementById('pinned-apps');\n540: Object.entries(APPS).filter(([k,a])=>a.pinned).forEach(([k,a])=>{\n541:   const b = document.createElement('button');\n542:   b.className='taskbar-app';\n543:   b.innerHTML = iconMarkup(a);\n544:   b.title = a.name;\n545:   b.onclick = ()=>toggleApp(k);\n546:   b.dataset.app = k;\n547:   pinnedLayer.appendChild(b);\n548: });\n549: \n550: /* ============ LAUNCHER ============ */\n551: const launcherGrid = document.getElementById('launcher-grid');\n552: function buildLauncher(filter=''){\n553:   launcherGrid.innerHTML='';\n554:   Object.entries(APPS).filter(([k,a])=>a.name.toLowerCase().includes(filter.toLowerCase())).forEach(([k,a])=>{\n555:     const el = document.createElement('div');\n556:     el.className='l-app';\n557:     el.innerHTML = `<div class=\"ico\">${iconMarkup(a)}</div><span>${a.name}</span>`;\n558:     el.onclick = ()=>{ openApp(k); closeLauncher(); };\n559:     launcherGrid.appendChild(el);\n560:   });\n561:   lucide.createIcons();\n562: }\n563: buildLauncher();\n564: document.getElementById('launcher-input').addEventListener('input', e=>buildLauncher(e.target.value));\n565: \n566: const launcherEl = document.getElementById('launcher');\n567: document.getElementById('launcher-btn').onclick = (e)=>{\n568:   e.stopPropagation();\n569:   launcherEl.classList.toggle('active');\n570:   document.getElementById('notif-center').classList.remove('active');\n571:   if(launcherEl.classList.contains('active')){\n572:     document.getElementById('launcher-input').value='';\n573:     buildLauncher();\n574:     setTimeout(()=>document.getElementById('launcher-input').focus(),50);\n575:   }\n576: };\n577: function closeLauncher(){ launcherEl.classList.remove('active'); }\n578: \n579: document.addEventListener('click', (e)=>{\n580:   if(!launcherEl.contains(e.target)) closeLauncher();\n581:   if(!document.getElementById('notif-center').contains(e.target) && e.target.id!=='notif-btn') document.getElementById('notif-center').classList.remove('active');\n582:   document.getElementById('ctx-menu').classList.remove('active');\n583: });\n584: \n585: /* ============ NOTIFICATIONS ============ */\n586: let notifs = [];\n587: const ncList = document.getElementById('nc-list');\n588: function pushNotif(kind, icon, title, desc, toast=true){\n589:   const n = {id:Date.now()+Math.random(), icon, title, desc};\n590:   notifs.unshift(n);\n591:   renderNotifCenter();\n592:   if(toast) showToast(icon, title, desc);\n593:   document.getElementById('notif-btn').querySelector('.notif-dot')?.remove();\n594:   const dot = document.createElement('div'); dot.className='notif-dot';\n595:   document.getElementById('notif-btn').appendChild(dot);\n596: }\n597: function renderNotifCenter(){\n598:   if(notifs.length===0){ ncList.innerHTML = `<div class=\"nc-empty\">You're all caught up</div>`; return; }\n599:   ncList.innerHTML = notifs.map(n=>`\n600:     <div class=\"nc-item\"><i data-lucide=\"${n.icon}\"></i><div><div class=\"t\">${n.title}</div><div class=\"d\">${n.desc}</div></div></div>\n601:   `).join('');\n602:   lucide.createIcons();\n603: }\n604: renderNotifCenter();\n605: document.getElementById('notif-btn').onclick = (e)=>{\n606:   e.stopPropagation();\n607:   document.getElementById('notif-center').classList.toggle('active');\n608:   launcherEl.classList.remove('active');\n609:   document.getElementById('notif-btn').querySelector('.notif-dot')?.remove();\n610: };\n611: document.getElementById('nc-clear').onclick = ()=>{ notifs=[]; renderNotifCenter(); };\n612: \n613: function showToast(icon, title, desc){\n614:   const box = document.getElementById('toasts');\n615:   const t = document.createElement('div');\n616:   t.className='toast';\n617:   t.innerHTML = `<i data-lucide=\"${icon}\"></i><div><div class=\"t\">${title}</div><div class=\"d\">${desc}</div></div>`;\n618:   box.appendChild(t);\n619:   lucide.createIcons();\n620:   setTimeout(()=>{ t.classList.add('out'); setTimeout(()=>t.remove(),220); }, 3800);\n621: }\n622: \n623: /* ============ WIFI / VOLUME quick toggles ============ */\n624: let wifiOn = true, volOn = true;\n625: document.getElementById('wifi-btn').onclick = ()=>{\n626:   wifiOn=!wifiOn;\n627:   document.getElementById('wifi-btn').innerHTML = `<i data-lucide=\"${wifiOn?'wifi':'wifi-off'}\"></i>`;\n628:   lucide.createIcons();\n629:   showToast(wifiOn?'wifi':'wifi-off', wifiOn?'Wi‑Fi connected':'Wi‑Fi disabled', wifiOn?'Endroid_Home5G':'Network access off');\n630: };\n631: document.getElementById('vol-btn').onclick = ()=>{\n632:   volOn=!volOn;\n633:   document.getElementById('vol-btn').innerHTML = `<i data-lucide=\"${volOn?'volume-2':'volume-x'}\"></i>`;\n634:   lucide.createIcons();\n635: };\n636: \n637: /* ============ CONTEXT MENU (desktop) ============ */\n638: const ctxMenu = document.getElementById('ctx-menu');\n639: document.getElementById('desktop').addEventListener('contextmenu', (e)=>{\n640:   e.preventDefault();\n641:   ctxMenu.innerHTML = `\n642:     <div class=\"ctx-item\" data-act=\"refresh\"><i data-lucide=\"refresh-cw\"></i>Refresh</div>\n643:     <div class=\"ctx-item\" data-act=\"newfolder\"><i data-lucide=\"folder-plus\"></i>New folder</div>\n644:     <div class=\"ctx-sep\"></div>\n645:     <div class=\"ctx-item\" data-act=\"settings\"><i data-lucide=\"palette\"></i>Personalize</div>\n646:     <div class=\"ctx-item\" data-act=\"terminal\"><i data-lucide=\"square-terminal\"></i>Open terminal here</div>\n647:   `;\n648:   ctxMenu.style.left = e.clientX+'px';\n649:   ctxMenu.style.top = e.clientY+'px';\n650:   ctxMenu.classList.add('active');\n651:   lucide.createIcons();\n652:   ctxMenu.querySelectorAll('.ctx-item').forEach(item=>{\n653:     item.onclick = ()=>{\n654:       const act = item.dataset.act;\n655:       if(act==='refresh') showToast('refresh-cw','Desktop refreshed','');\n656:       if(act==='newfolder') showToast('folder-plus','Folder created','New Folder added to desktop');\n657:       if(act==='settings') openApp('settings');\n658:       if(act==='terminal') openApp('terminal');\n659:       ctxMenu.classList.remove('active');\n660:     };\n661:   });\n662: });\n663: \n664: /* ============ WINDOW MANAGEMENT ============ */\n665: function openApp(key){\n666:   if(openWindows[key] && openWindows[key].el){\n667:     restoreWindow(key);\n668:     focusWindow(key);\n669:     return;\n670:   }\n671:   createWindow(key);\n672: }\n673: function toggleApp(key){\n674:   if(openWindows[key] && openWindows[key].el){\n675:     const w = openWindows[key];\n676:     if(w.minimized || w.el.style.display==='none'){ restoreWindow(key); focusWindow(key); }\n677:     else if(isFocused(key)){ minimizeWindow(key); }\n678:     else { focusWindow(key); }\n679:   } else {\n680:     createWindow(key);\n681:   }\n682: }\n683: function isFocused(key){\n684:   return openWindows[key] && openWindows[key].el.classList.contains('focused');\n685: }\n686: \n687: function createWindow(key){\n688:   const app = APPS[key];\n689:   const layer = document.getElementById('windows-layer');\n690:   const id = 'win-'+key;\n691:   const el = document.createElement('div');\n692:   el.className='window';\n693:   el.id = id;\n694:   winCount++;\n695:   const offset = (winCount%6)*26;\n696:   const w = key==='calc'? 320 : 640, h = key==='calc'? 480: 440;\n697:   el.style.width = w+'px';\n698:   el.style.height = h+'px';\n699:   el.style.left = (90+offset)+'px';\n700:   el.style.top = (50+offset)+'px';\n701:   el.style.zIndex = ++zTop;\n702: \n703:   el.innerHTML = `\n704:     <div class=\"win-titlebar\">\n705:       <span class=\"win-ico\" style=\"display:inline-flex;width:16px;height:16px;\">${iconMarkup(app)}</span>\n706:       <div class=\"win-title\">${app.name}</div>\n707:       <div class=\"win-controls\">\n708:         <button class=\"win-btn min\" title=\"Minimize\"><i data-lucide=\"minus\"></i></button>\n709:         <button class=\"win-btn max\" title=\"Maximize\"><i data-lucide=\"square\"></i></button>\n710:         <button class=\"win-btn close\" title=\"Close\"><i data-lucide=\"x\"></i></button>\n711:       </div>\n712:     </div>\n713:     <div class=\"win-body\"></div>\n714:     <div class=\"resize-handle\"></div>\n715:   `;\n716:   layer.appendChild(el);\n717:   const body = el.querySelector('.win-body');\n718:   app.render(body, key);\n719: \n720:   openWindows[key] = {el, minimized:false, maximized:false, prevRect:null};\n721: \n722:   el.addEventListener('mousedown', ()=>focusWindow(key));\n723:   makeDraggable(el, el.querySelector('.win-titlebar'));\n724:   makeResizable(el, el.querySelector('.resize-handle'));\n725: \n726:   el.querySelector('.min').onclick = (e)=>{e.stopPropagation(); minimizeWindow(key);};\n727:   el.querySelector('.max').onclick = (e)=>{e.stopPropagation(); toggleMaximize(key);};\n728:   el.querySelector('.close').onclick = (e)=>{e.stopPropagation(); closeWindow(key);};\n729:   el.querySelector('.win-titlebar').ondblclick = ()=>toggleMaximize(key);\n730: \n731:   addTaskbarRunning(key);\n732:   focusWindow(key);\n733:   lucide.createIcons();\n734: }\n735: \n736: function addTaskbarRunning(key){\n737:   const app = APPS[key];\n738:   const run = document.getElementById('running-apps');\n739:   if(app.pinned){\n740:     const pinBtn = pinnedLayer.querySelector(`[data-app=\"${key}\"]`);\n741:     pinBtn.classList.add('running','active');\n742:     return;\n743:   }\n744:   let b = run.querySelector(`[data-app=\"${key}\"]`);\n745:   if(!b){\n746:     b = document.createElement('button');\n747:     b.className='taskbar-app running active';\n748:     b.dataset.app = key;\n749:     b.innerHTML = `<span style=\"display:inline-flex;width:17px;height:17px;\">${iconMarkup(app)}</span><span>${app.name}</span>`;\n750:     b.onclick = ()=>toggleApp(key);\n751:     run.appendChild(b);\n752:     lucide.createIcons();\n753:   }\n754: }\n755: function removeTaskbarRunning(key){\n756:   const app = APPS[key];\n757:   if(app.pinned){\n758:     pinnedLayer.querySelector(`[data-app=\"${key}\"]`)?.classList.remove('running','active');\n759:   } else {\n760:     document.getElementById('running-apps').querySelector(`[data-app=\"${key}\"]`)?.remove();\n761:   }\n762: }\n763: \n764: function focusWindow(key){\n765:   document.querySelectorAll('.window').forEach(w=>w.classList.remove('focused'));\n766:   document.querySelectorAll('.taskbar-app').forEach(b=>b.classList.remove('active'));\n767:   const w = openWindows[key];\n768:   if(!w) return;\n769:   w.el.style.zIndex = ++zTop;\n770:   w.el.classList.add('focused');\n771:   const tb = document.querySelector(`.taskbar-app[data-app=\"${key}\"]`);\n772:   tb?.classList.add('active');\n773: }\n774: function minimizeWindow(key){\n775:   const w = openWindows[key];\n776:   w.el.style.display='none';\n777:   w.minimized = true;\n778:   document.querySelector(`.taskbar-app[data-app=\"${key}\"]`)?.classList.remove('active');\n779: }\n780: function restoreWindow(key){\n781:   const w = openWindows[key];\n782:   w.el.style.display='flex';\n783:   w.minimized = false;\n784: }\n785: function toggleMaximize(key){\n786:   const w = openWindows[key];\n787:   const el = w.el;\n788:   if(!w.maximized){\n789:     w.prevRect = {left:el.style.left, top:el.style.top, width:el.style.width, height:el.style.height};\n790:     el.style.left='0px'; el.style.top='0px';\n791:     el.style.width='100%'; el.style.height='calc(100% - 56px)';\n792:     w.maximized = true;\n793:   } else {\n794:     Object.assign(el.style, w.prevRect);\n795:     w.maximized = false;\n796:   }\n797: }\n798: function closeWindow(key){\n799:   const w = openWindows[key];\n800:   if(!w) return;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
