{"step_index":44,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-19T06:00:56Z","content":"Created At: 2026-08-19T06:00:56Z\nCompleted At: 2026-08-19T06:00:56Z\nFile Path: `file:///C:/Users/Bullettemporary/.gemini/antigravity/scratch/endroid-os-index.html`\nTotal Lines: 2246\nTotal Bytes: 111548\nShowing lines 801 to 1600\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n801:   w.el.classList.add('closing');\n802:   setTimeout(()=>{ w.el.remove(); }, 160);\n803:   removeTaskbarRunning(key);\n804:   delete openWindows[key];\n805: }\n806: \n807: function makeDraggable(el, handle){\n808:   let sx,sy,ox,oy,dragging=false;\n809:   handle.addEventListener('mousedown', e=>{\n810:     if(e.target.closest('.win-btn')) return;\n811:     if(openWindows[Object.keys(openWindows).find(k=>openWindows[k].el===el)]?.maximized) return;\n812:     dragging=true;\n813:     sx=e.clientX; sy=e.clientY;\n814:     const r = el.getBoundingClientRect();\n815:     ox=r.left; oy=r.top;\n816:     document.body.style.userSelect='none';\n817:   });\n818:   window.addEventListener('mousemove', e=>{\n819:     if(!dragging) return;\n820:     const nx = ox + (e.clientX-sx);\n821:     const ny = Math.max(0, oy + (e.clientY-sy));\n822:     el.style.left = nx+'px';\n823:     el.style.top = ny+'px';\n824:   });\n825:   window.addEventListener('mouseup', ()=>{dragging=false; document.body.style.userSelect='';});\n826: }\n827: function makeResizable(el, handle){\n828:   let sx,sy,sw,sh,resizing=false;\n829:   handle.addEventListener('mousedown', e=>{\n830:     e.stopPropagation();\n831:     resizing=true;\n832:     sx=e.clientX; sy=e.clientY;\n833:     const r = el.getBoundingClientRect();\n834:     sw=r.width; sh=r.height;\n835:   });\n836:   window.addEventListener('mousemove', e=>{\n837:     if(!resizing) return;\n838:     el.style.width = Math.max(320, sw+(e.clientX-sx))+'px';\n839:     el.style.height = Math.max(220, sh+(e.clientY-sy))+'px';\n840:   });\n841:   window.addEventListener('mouseup', ()=>resizing=false);\n842: }\n843: \n844: /* ============================================================\n845:    APP: FILE MANAGER\n846:    ============================================================ */\n847: const FS = {\n848:   'Home': {type:'folder', children:{\n849:     'Documents': {type:'folder', children:{\n850:       'resume.txt': {type:'file', icon:'file-text'},\n851:       'notes-endroid.md': {type:'file', icon:'file-text'},\n852:     }},\n853:     'Downloads': {type:'folder', children:{\n854:       'endroid-wallpaper.png': {type:'file', icon:'image'},\n855:       'sample-app.epk': {type:'file', icon:'package'},\n856:     }},\n857:     'Pictures': {type:'folder', children:{\n858:       'screenshot-01.png': {type:'file', icon:'image'},\n859:       'screenshot-02.png': {type:'file', icon:'image'},\n860:     }},\n861:     'Projects': {type:'folder', children:{\n862:       'endroid-os': {type:'folder', children:{\n863:         'manifest.json':{type:'file', icon:'file-json'},\n864:         'index.html':{type:'file', icon:'file-code'},\n865:       }},\n866:     }},\n867:   }}\n868: };\n869: function renderFiles(body){\n870:   let path = ['Home'];\n871:   body.innerHTML = `\n872:     <div class=\"app-pane\">\n873:       <div class=\"app-toolbar\">\n874:         <button id=\"fm-back\"><i data-lucide=\"arrow-left\"></i></button>\n875:         <button id=\"fm-up\"><i data-lucide=\"arrow-up\"></i></button>\n876:         <div class=\"path\" id=\"fm-path\">/Home</div>\n877:         <button id=\"fm-new\"><i data-lucide=\"folder-plus\"></i></button>\n878:       </div>\n879:       <div class=\"content\"><div class=\"fm-grid\" id=\"fm-grid\"></div></div>\n880:     </div>\n881:   `;\n882:   const grid = body.querySelector('#fm-grid');\n883:   const pathEl = body.querySelector('#fm-path');\n884:   const history = [];\n885: \n886:   function getNode(p){\n887:     let node = FS[p[0]];\n888:     for(let i=1;i<p.length;i++) node = node.children[p[i]];\n889:     return node;\n890:   }\n891:   function draw(){\n892:     pathEl.textContent = '/'+path.join('/');\n893:     const node = getNode(path);\n894:     grid.innerHTML='';\n895:     const entries = Object.entries(node.children||{});\n896:     if(entries.length===0){ grid.innerHTML = `<div style=\"grid-column:1/-1;padding:30px;text-align:center;color:var(--text-2);font-size:12px;\">This folder is empty</div>`; return; }\n897:     entries.forEach(([name, n])=>{\n898:       const el = document.createElement('div');\n899:       el.className='fm-item';\n900:       const icon = n.type==='folder' ? 'folder' : (n.icon||'file');\n901:       const color = n.type==='folder' ? 'var(--accent)' : 'var(--text-1)';\n902:       el.innerHTML = `<div class=\"ico\"><i data-lucide=\"${icon}\" style=\"stroke:${color}\"></i></div><span>${name}</span>`;\n903:       el.onclick = (e)=>{\n904:         e.stopPropagation();\n905:         grid.querySelectorAll('.fm-item').forEach(x=>x.classList.remove('selected'));\n906:         el.classList.add('selected');\n907:       };\n908:       el.ondblclick = ()=>{\n909:         if(n.type==='folder'){ history.push([...path]); path.push(name); draw(); }\n910:         else { showToast(icon, 'Opening '+name, 'No default application set for this file type'); }\n911:       };\n912:       grid.appendChild(el);\n913:     });\n914:     lucide.createIcons();\n915:   }\n916:   body.querySelector('#fm-back').onclick = ()=>{ if(history.length){ path = history.pop(); draw(); } };\n917:   body.querySelector('#fm-up').onclick = ()=>{ if(path.length>1){ history.push([...path]); path.pop(); draw(); } };\n918:   body.querySelector('#fm-new').onclick = ()=>{\n919:     const node = getNode(path);\n920:     const name = 'New Folder';\n921:     let n2 = name, i=1;\n922:     while(node.children[n2]) n2 = name+' ('+(i++)+')';\n923:     node.children[n2] = {type:'folder', children:{}};\n924:     draw();\n925:     pushNotif('files','folder-plus','Folder created', n2+' was added', false);\n926:   };\n927:   draw();\n928: }\n929: \n930: /* ============================================================\n931:    APP: BROWSER\n932:    ============================================================ */\n933: function renderBrowser(body){\n934:   body.innerHTML = `\n935:     <div class=\"app-pane\">\n936:       <div class=\"browser-bar\">\n937:         <button style=\"background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex:0 0 auto;\" id=\"br-back\"><i data-lucide=\"arrow-left\" style=\"width:14px;height:14px;\"></i></button>\n938:         <button style=\"background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex:0 0 auto;\" id=\"br-home\"><i data-lucide=\"home\" style=\"width:14px;height:14px;\"></i></button>\n939:         <input type=\"text\" id=\"br-url\" placeholder=\"Search Google or enter a web address\" />\n940:         <button style=\"background:var(--accent);border:none;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:#08110F;cursor:pointer;flex:0 0 auto;\" id=\"br-go\"><i data-lucide=\"arrow-right\" style=\"width:14px;height:14px;\"></i></button>\n941:       </div>\n942:       <div class=\"content\" style=\"padding:0;\" id=\"br-content\"></div>\n943:     </div>\n944:   `;\n945:   lucide.createIcons();\n946:   const content = body.querySelector('#br-content');\n947:   const urlInput = body.querySelector('#br-url');\n948:   let historyStack = [];\n949: \n950:   function home(){\n951:     content.innerHTML = `\n952:       <div class=\"browser-home\">\n953:         <i data-lucide=\"compass\"></i>\n954:         <h2>Endroid Browser</h2>\n955:         <p>Search the web or type any address — pages load right here.</p>\n956:         <div class=\"bh-grid\">\n957:           <div class=\"bh-card\" data-u=\"https://en.wikipedia.org\"><i data-lucide=\"book-open\"></i><span>Wikipedia</span></div>\n958:           <div class=\"bh-card\" data-u=\"https://news.ycombinator.com\"><i data-lucide=\"newspaper\"></i><span>Hacker News</span></div>\n959:           <div class=\"bh-card\" data-search=\"Endroid OS\"><i data-lucide=\"search\"></i><span>Search \"Endroid OS\"</span></div>\n960:           <div class=\"bh-card\" data-u=\"https://example.com\"><i data-lucide=\"globe\"></i><span>Example.com</span></div>\n961:         </div>\n962:       </div>\n963:     `;\n964:     lucide.createIcons();\n965:     urlInput.value='';\n966:     content.querySelectorAll('.bh-card').forEach(c=>{\n967:       c.onclick = ()=> c.dataset.u ? loadUrl(c.dataset.u) : doSearch(c.dataset.search);\n968:     });\n969:   }\n970: \n971:   function showFrame(src, displayVal){\n972:     historyStack.push(src);\n973:     urlInput.value = displayVal || src;\n974:     content.innerHTML = `<iframe src=\"${src}\" style=\"width:100%;height:100%;border:none;background:#fff;\" referrerpolicy=\"no-referrer\" sandbox=\"allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox\"></iframe>`;\n975:   }\n976: \n977:   function doSearch(q){\n978:     // Google's igu=1 param allows the results page to be embedded in an iframe\n979:     const src = 'https://www.google.com/search?igu=1&q=' + encodeURIComponent(q);\n980:     showFrame(src, q);\n981:   }\n982: \n983:   function loadUrl(u){\n984:     let target = u.trim();\n985:     if(!target){ return; }\n986:     const looksLikeUrl = /^https?:\\/\\//i.test(target) || (/\\.[a-z]{2,}$/i.test(target) && !target.includes(' '));\n987:     if(!looksLikeUrl){ doSearch(target); return; }\n988:     if(!/^https?:\\/\\//i.test(target)) target = 'https://' + target;\n989:     showFrame(target, target.replace(/^https?:\\/\\//,''));\n990:   }\n991: \n992:   function navigateTo(u){ loadUrl(u); }\n993: \n994:   body.querySelector('#br-home').onclick = ()=>{ historyStack=[]; home(); };\n995:   body.querySelector('#br-back').onclick = ()=>{\n996:     historyStack.pop();\n997:     const prev = historyStack.pop();\n998:     if(prev) showFrame(prev); else home();\n999:   };\n1000:   body.querySelector('#br-go').onclick = ()=>navigateTo(urlInput.value);\n1001:   urlInput.addEventListener('keydown', e=>{ if(e.key==='Enter') navigateTo(e.target.value); });\n1002:   home();\n1003: }\n1004: \n1005: /* ============================================================\n1006:    APP: NOTES\n1007:    ============================================================ */\n1008: /* ============================================================\n1009:    APP: WEATHER (Open-Meteo, live API)\n1010:    ============================================================ */\n1011: const WMO = {\n1012:   0:['Clear sky','sun'],1:['Mainly clear','sun'],2:['Partly cloudy','cloud-sun'],3:['Overcast','cloud'],\n1013:   45:['Fog','cloud-fog'],48:['Rime fog','cloud-fog'],\n1014:   51:['Light drizzle','cloud-drizzle'],53:['Drizzle','cloud-drizzle'],55:['Dense drizzle','cloud-drizzle'],\n1015:   61:['Light rain','cloud-rain'],63:['Rain','cloud-rain'],65:['Heavy rain','cloud-rain-wind'],\n1016:   71:['Light snow','cloud-snow'],73:['Snow','cloud-snow'],75:['Heavy snow','cloud-snow'],\n1017:   80:['Rain showers','cloud-rain'],81:['Rain showers','cloud-rain'],82:['Violent showers','cloud-rain-wind'],\n1018:   95:['Thunderstorm','cloud-lightning'],96:['Thunderstorm w/ hail','cloud-lightning'],99:['Severe storm','cloud-lightning'],\n1019: };\n1020: function renderWeather(body){\n1021:   body.innerHTML = `\n1022:     <div class=\"app-pane\">\n1023:       <div class=\"app-toolbar\">\n1024:         <i data-lucide=\"map-pin\" style=\"width:14px;height:14px;stroke:var(--text-2);flex:0 0 auto;\"></i>\n1025:         <input id=\"wx-city\" type=\"text\" placeholder=\"Search a city…\" value=\"London\"\n1026:           style=\"flex:1;background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;padding:7px 10px;color:var(--text-0);font-size:12.5px;outline:none;\">\n1027:         <button id=\"wx-go\"><i data-lucide=\"search\"></i></button>\n1028:       </div>\n1029:       <div class=\"content\" id=\"wx-content\">\n1030:         <div class=\"empty-state\"><i data-lucide=\"loader\"></i><span>Loading weather…</span></div>\n1031:       </div>\n1032:     </div>\n1033:   `;\n1034:   lucide.createIcons();\n1035:   const contentEl = body.querySelector('#wx-content');\n1036:   const cityInput = body.querySelector('#wx-city');\n1037: \n1038:   async function search(city){\n1039:     contentEl.innerHTML = `<div class=\"empty-state\"><i data-lucide=\"loader\"></i><span>Loading weather…</span></div>`;\n1040:     lucide.createIcons();\n1041:     try{\n1042:       const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`);\n1043:       const geo = await geoRes.json();\n1044:       if(!geo.results || !geo.results.length){\n1045:         contentEl.innerHTML = `<div class=\"empty-state\"><i data-lucide=\"map-pin-off\"></i><span>No location found for \"${city}\"</span></div>`;\n1046:         lucide.createIcons();\n1047:         return;\n1048:       }\n1049:       const place = geo.results[0];\n1050:       const wxRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=auto`);\n1051:       const wx = await wxRes.json();\n1052:       drawWeather(place, wx);\n1053:     }catch(e){\n1054:       contentEl.innerHTML = `<div class=\"empty-state\"><i data-lucide=\"wifi-off\"></i><span>Couldn't reach the weather service. Try again.</span></div>`;\n1055:       lucide.createIcons();\n1056:     }\n1057:   }\n1058: \n1059:   function drawWeather(place, wx){\n1060:     const cur = wx.current;\n1061:     const [curLabel, curIcon] = WMO[cur.weather_code] || ['Unknown','cloud'];\n1062:     const days = wx.daily.time.map((d,i)=>({\n1063:       d, max: Math.round(wx.daily.temperature_2m_max[i]), min: Math.round(wx.daily.temperature_2m_min[i]),\n1064:       icon: (WMO[wx.daily.weather_code[i]]||['','cloud'])[1]\n1065:     })).slice(0,6);\n1066:     contentEl.innerHTML = `\n1067:       <div style=\"text-align:center;padding:10px 0 18px;\">\n1068:         <div style=\"font-size:12.5px;color:var(--text-1);\">${place.name}${place.admin1? ', '+place.admin1:''}, ${place.country}</div>\n1069:         <i data-lucide=\"${curIcon}\" style=\"width:56px;height:56px;stroke:var(--accent);margin:10px 0;\"></i>\n1070:         <div style=\"font-family:var(--font-display);font-size:44px;font-weight:600;color:var(--text-0);\">${Math.round(cur.temperature_2m)}°C</div>\n1071:         <div style=\"font-size:12.5px;color:var(--text-1);\">${curLabel} · Feels like ${Math.round(cur.apparent_temperature)}°C</div>\n1072:       </div>\n1073:       <div style=\"display:flex;gap:8px;margin-bottom:18px;\">\n1074:         <div style=\"flex:1;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:10px;padding:12px;text-align:center;\">\n1075:           <div style=\"font-size:10.5px;color:var(--text-2);text-transform:uppercase;letter-spacing:0.4px;\">Humidity</div>\n1076:           <div style=\"font-size:16px;font-weight:600;color:var(--text-0);margin-top:4px;\">${cur.relative_humidity_2m}%</div>\n1077:         </div>\n1078:         <div style=\"flex:1;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:10px;padding:12px;text-align:center;\">\n1079:           <div style=\"font-size:10.5px;color:var(--text-2);text-transform:uppercase;letter-spacing:0.4px;\">Wind</div>\n1080:           <div style=\"font-size:16px;font-weight:600;color:var(--text-0);margin-top:4px;\">${Math.round(cur.wind_speed_10m)} km/h</div>\n1081:         </div>\n1082:       </div>\n1083:       <div style=\"font-size:10.5px;color:var(--text-2);text-transform:uppercase;letter-spacing:0.4px;margin-bottom:8px;\">6‑day forecast</div>\n1084:       <div style=\"display:flex;flex-direction:column;gap:4px;\">\n1085:         ${days.map(day=>`\n1086:           <div style=\"display:flex;align-items:center;gap:10px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:9px;padding:9px 12px;\">\n1087:             <div style=\"width:70px;font-size:11.5px;color:var(--text-1);\">${new Date(day.d+'T00:00').toLocaleDateString([], {weekday:'short'})}</div>\n1088:             <i data-lucide=\"${day.icon}\" style=\"width:16px;height:16px;stroke:var(--accent);\"></i>\n1089:             <div style=\"flex:1;\"></div>\n1090:             <div style=\"font-size:12px;color:var(--text-2);\">${day.min}°</div>\n1091:             <div style=\"font-size:12px;font-weight:600;color:var(--text-0);\">${day.max}°</div>\n1092:           </div>\n1093:         `).join('')}\n1094:       </div>\n1095:     `;\n1096:     lucide.createIcons();\n1097:   }\n1098: \n1099:   body.querySelector('#wx-go').onclick = ()=>search(cityInput.value || 'London');\n1100:   cityInput.addEventListener('keydown', e=>{ if(e.key==='Enter') search(cityInput.value || 'London'); });\n1101:   search('London');\n1102: }\n1103: \n1104: /* ============================================================\n1105:    APP: USELESS FACTS (live API)\n1106:    ============================================================ */\n1107: function renderFacts(body){\n1108:   body.innerHTML = `\n1109:     <div class=\"app-pane\">\n1110:       <div class=\"content\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;height:100%;\">\n1111:         <i data-lucide=\"sparkles\" style=\"width:34px;height:34px;stroke:var(--accent);margin-bottom:16px;\"></i>\n1112:         <div id=\"fact-text\" style=\"font-family:var(--font-display);font-size:17px;line-height:1.5;color:var(--text-0);max-width:420px;margin-bottom:22px;\">Loading a useless fact…</div>\n1113:         <button id=\"fact-next\" style=\"background:var(--accent);border:none;border-radius:9px;padding:10px 20px;color:#08110F;font-weight:600;font-size:12.5px;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;gap:7px;\">\n1114:           <i data-lucide=\"refresh-cw\" style=\"width:14px;height:14px;\"></i>Another fact\n1115:         </button>\n1116:       </div>\n1117:     </div>\n1118:   `;\n1119:   lucide.createIcons();\n1120:   const textEl = body.querySelector('#fact-text');\n1121:   const btn = body.querySelector('#fact-next');\n1122:   async function loadFact(){\n1123:     textEl.textContent = 'Loading a useless fact…';\n1124:     btn.disabled = true;\n1125:     try{\n1126:       const res = await fetch('https://useless.endroid.workers.dev/api/v1');\n1127:       const data = await res.json();\n1128:       const fact = data.fact || data.text || data.data || (typeof data==='string'? data : JSON.stringify(data));\n1129:       textEl.textContent = fact;\n1130:     }catch(e){\n1131:       textEl.textContent = \"Couldn't fetch a fact right now — the useless facts service might be unreachable.\";\n1132:     }\n1133:     btn.disabled = false;\n1134:   }\n1135:   btn.onclick = loadFact;\n1136:   loadFact();\n1137: }\n1138: \n1139: /* ============================================================\n1140:    APP: CURRENCY CONVERTER (frankfurter.app, live API, no key)\n1141:    ============================================================ */\n1142: function renderCurrency(body){\n1143:   body.innerHTML = `\n1144:     <div class=\"app-pane\">\n1145:       <div class=\"content\" style=\"max-width:420px;\">\n1146:         <div style=\"display:flex;gap:10px;align-items:flex-end;margin-bottom:14px;\">\n1147:           <div style=\"flex:1;\">\n1148:             <div style=\"font-size:10.5px;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;\">Amount</div>\n1149:             <input id=\"cv-amount\" type=\"number\" value=\"100\" style=\"width:100%;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 10px;color:var(--text-0);font-size:14px;outline:none;\">\n1150:           </div>\n1151:           <div>\n1152:             <div style=\"font-size:10.5px;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;\">From</div>\n1153:             <select id=\"cv-from\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 8px;color:var(--text-0);font-size:13px;outline:none;\"></select>\n1154:           </div>\n1155:           <button id=\"cv-swap\" style=\"background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;\"><i data-lucide=\"arrow-left-right\" style=\"width:15px;height:15px;\"></i></button>\n1156:           <div>\n1157:             <div style=\"font-size:10.5px;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;\">To</div>\n1158:             <select id=\"cv-to\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 8px;color:var(--text-0);font-size:13px;outline:none;\"></select>\n1159:           </div>\n1160:         </div>\n1161:         <div id=\"cv-result\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:12px;padding:20px;text-align:center;\">\n1162:           <div class=\"empty-state\" style=\"height:auto;padding:10px 0;\"><i data-lucide=\"loader\"></i><span>Loading rates…</span></div>\n1163:         </div>\n1164:         <div id=\"cv-updated\" style=\"font-size:10.5px;color:var(--text-2);text-align:center;margin-top:10px;\"></div>\n1165:       </div>\n1166:     </div>\n1167:   `;\n1168:   lucide.createIcons();\n1169:   const CURRENCIES = ['USD','EUR','GBP','JPY','INR','PKR','AUD','CAD','CNY','CHF','AED','SGD'];\n1170:   const fromSel = body.querySelector('#cv-from');\n1171:   const toSel = body.querySelector('#cv-to');\n1172:   CURRENCIES.forEach(c=>{\n1173:     fromSel.innerHTML += `<option value=\"${c}\" ${c==='USD'?'selected':''}>${c}</option>`;\n1174:     toSel.innerHTML += `<option value=\"${c}\" ${c==='PKR'?'selected':''}>${c}</option>`;\n1175:   });\n1176:   const amountEl = body.querySelector('#cv-amount');\n1177:   const resultEl = body.querySelector('#cv-result');\n1178:   const updatedEl = body.querySelector('#cv-updated');\n1179: \n1180:   async function convert(){\n1181:     resultEl.innerHTML = `<div class=\"empty-state\" style=\"height:auto;padding:10px 0;\"><i data-lucide=\"loader\"></i><span>Converting…</span></div>`;\n1182:     lucide.createIcons();\n1183:     const amt = parseFloat(amountEl.value) || 0;\n1184:     const from = fromSel.value, to = toSel.value;\n1185:     try{\n1186:       const res = await fetch(`https://api.frankfurter.app/latest?amount=${amt}&from=${from}&to=${to}`);\n1187:       const data = await res.json();\n1188:       const val = data.rates[to];\n1189:       resultEl.innerHTML = `\n1190:         <div style=\"font-size:11.5px;color:var(--text-2);margin-bottom:6px;\">${amt} ${from} equals</div>\n1191:         <div style=\"font-family:var(--font-display);font-size:32px;font-weight:600;color:var(--accent);\">${val.toLocaleString(undefined,{maximumFractionDigits:2})} ${to}</div>\n1192:       `;\n1193:       updatedEl.textContent = 'Rates as of ' + data.date;\n1194:     }catch(e){\n1195:       resultEl.innerHTML = `<div class=\"empty-state\" style=\"height:auto;padding:10px 0;\"><i data-lucide=\"wifi-off\"></i><span>Couldn't fetch exchange rates.</span></div>`;\n1196:       lucide.createIcons();\n1197:     }\n1198:   }\n1199:   body.querySelector('#cv-swap').onclick = ()=>{\n1200:     const f = fromSel.value; fromSel.value = toSel.value; toSel.value = f;\n1201:     convert();\n1202:   };\n1203:   [amountEl, fromSel, toSel].forEach(el=>el.addEventListener('change', convert));\n1204:   amountEl.addEventListener('input', ()=>{ clearTimeout(window.__cvT); window.__cvT=setTimeout(convert,400); });\n1205:   convert();\n1206: }\n1207: \n1208: /* ============================================================\n1209:    APP: PASSWORD GENERATOR (fully client-side, working)\n1210:    ============================================================ */\n1211: function renderPassword(body){\n1212:   body.innerHTML = `\n1213:     <div class=\"app-pane\">\n1214:       <div class=\"content\" style=\"max-width:420px;\">\n1215:         <div style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:12px;padding:18px;margin-bottom:16px;display:flex;align-items:center;gap:10px;\">\n1216:           <div id=\"pw-output\" style=\"flex:1;font-family:var(--font-mono);font-size:16px;color:var(--text-0);word-break:break-all;\">••••••••••••</div>\n1217:           <button id=\"pw-copy\" style=\"background:var(--bg-3);border:1px solid var(--line-soft);border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:var(--text-1);cursor:pointer;flex:0 0 auto;\"><i data-lucide=\"copy\" style=\"width:14px;height:14px;\"></i></button>\n1218:         </div>\n1219:         <div class=\"set-row\"><div class=\"lbl\">Length: <span id=\"pw-len-val\">16</span></div><input id=\"pw-len\" type=\"range\" min=\"6\" max=\"48\" value=\"16\" style=\"width:160px;accent-color:var(--accent);\"></div>\n1220:         <div class=\"set-row\"><div class=\"lbl\">Uppercase (A–Z)</div><div class=\"toggle on\" data-k=\"upper\"><div class=\"knob\"></div></div></div>\n1221:         <div class=\"set-row\"><div class=\"lbl\">Lowercase (a–z)</div><div class=\"toggle on\" data-k=\"lower\"><div class=\"knob\"></div></div></div>\n1222:         <div class=\"set-row\"><div class=\"lbl\">Numbers (0–9)</div><div class=\"toggle on\" data-k=\"numbers\"><div class=\"knob\"></div></div></div>\n1223:         <div class=\"set-row\"><div class=\"lbl\">Symbols (!@#$…)</div><div class=\"toggle on\" data-k=\"symbols\"><div class=\"knob\"></div></div></div>\n1224:         <button id=\"pw-gen\" style=\"width:100%;margin-top:8px;background:var(--accent);border:none;border-radius:9px;padding:11px;color:#08110F;font-weight:600;font-size:12.5px;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;justify-content:center;gap:7px;\">\n1225:           <i data-lucide=\"refresh-cw\" style=\"width:14px;height:14px;\"></i>Generate new password\n1226:         </button>\n1227:       </div>\n1228:     </div>\n1229:   `;\n1230:   lucide.createIcons();\n1231:   const opts = {upper:true, lower:true, numbers:true, symbols:true};\n1232:   const lenInput = body.querySelector('#pw-len');\n1233:   const lenVal = body.querySelector('#pw-len-val');\n1234:   const output = body.querySelector('#pw-output');\n1235:   const sets = {\n1236:     upper:'ABCDEFGHIJKLMNOPQRSTUVWXYZ', lower:'abcdefghijklmnopqrstuvwxyz',\n1237:     numbers:'0123456789', symbols:'!@#$%^&*()-_=+[]{}?'\n1238:   };\n1239:   function generate(){\n1240:     let pool = '';\n1241:     Object.keys(opts).forEach(k=>{ if(opts[k]) pool += sets[k]; });\n1242:     if(!pool){ output.textContent = 'Select at least one character type'; return; }\n1243:     const len = parseInt(lenInput.value);\n1244:     const arr = new Uint32Array(len);\n1245:     crypto.getRandomValues(arr);\n1246:     let pass = '';\n1247:     for(let i=0;i<len;i++) pass += pool[arr[i] % pool.length];\n1248:     output.textContent = pass;\n1249:   }\n1250:   lenInput.addEventListener('input', ()=>{ lenVal.textContent = lenInput.value; generate(); });\n1251:   body.querySelectorAll('.toggle[data-k]').forEach(t=>{\n1252:     t.onclick = ()=>{ const k=t.dataset.k; opts[k]=!opts[k]; t.classList.toggle('on'); generate(); };\n1253:   });\n1254:   body.querySelector('#pw-gen').onclick = generate;\n1255:   body.querySelector('#pw-copy').onclick = ()=>{\n1256:     navigator.clipboard?.writeText(output.textContent).then(()=>showToast('check','Copied','Password copied to clipboard'));\n1257:   };\n1258:   generate();\n1259: }\n1260: \n1261: /* ============================================================\n1262:    APP: QR CODE GENERATOR (api.qrserver.com, live, working)\n1263:    ============================================================ */\n1264: function renderQR(body){\n1265:   body.innerHTML = `\n1266:     <div class=\"app-pane\">\n1267:       <div class=\"content\" style=\"display:flex;flex-direction:column;align-items:center;\">\n1268:         <input id=\"qr-text\" type=\"text\" placeholder=\"Enter text or URL…\" value=\"https://endroid.zone.id\"\n1269:           style=\"width:100%;max-width:360px;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:9px;padding:10px 12px;color:var(--text-0);font-size:13px;outline:none;margin-bottom:16px;\">\n1270:         <div style=\"background:#fff;border-radius:14px;padding:16px;box-shadow:0 10px 30px rgba(0,0,0,0.25);\">\n1271:           <img id=\"qr-img\" width=\"220\" height=\"220\" style=\"display:block;\" src=\"\" alt=\"QR code\">\n1272:         </div>\n1273:         <button id=\"qr-dl\" style=\"margin-top:16px;background:var(--accent);border:none;border-radius:9px;padding:9px 18px;color:#08110F;font-weight:600;font-size:12.5px;cursor:pointer;font-family:var(--font-body);display:flex;align-items:center;gap:7px;\">\n1274:           <i data-lucide=\"download\" style=\"width:14px;height:14px;\"></i>Download PNG\n1275:         </button>\n1276:       </div>\n1277:     </div>\n1278:   `;\n1279:   lucide.createIcons();\n1280:   const input = body.querySelector('#qr-text');\n1281:   const img = body.querySelector('#qr-img');\n1282:   function update(){\n1283:     const text = input.value.trim() || 'https://endroid.zone.id';\n1284:     img.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(text)}`;\n1285:   }\n1286:   input.addEventListener('input', ()=>{ clearTimeout(window.__qrT); window.__qrT=setTimeout(update,350); });\n1287:   body.querySelector('#qr-dl').onclick = ()=>{\n1288:     const a = document.createElement('a');\n1289:     a.href = img.src; a.download = 'endroid-qr.png'; a.target='_blank';\n1290:     a.click();\n1291:   };\n1292:   update();\n1293: }\n1294: \n1295: /* ============================================================\n1296:    APP: UNIT CONVERTER (fully client-side, working)\n1297:    ============================================================ */\n1298: const UNIT_GROUPS = {\n1299:   Length: { m:1, km:1000, cm:0.01, mm:0.001, mi:1609.344, yd:0.9144, ft:0.3048, in:0.0254 },\n1300:   Weight: { kg:1, g:0.001, mg:0.000001, lb:0.453592, oz:0.0283495, ton:1000 },\n1301:   Temperature: null, // special-cased\n1302:   Data: { B:1, KB:1024, MB:1024**2, GB:1024**3, TB:1024**4 },\n1303: };\n1304: function renderUnits(body){\n1305:   body.innerHTML = `\n1306:     <div class=\"app-pane\">\n1307:       <div class=\"app-toolbar\">\n1308:         <div class=\"seg\" id=\"un-group\" style=\"flex:1;\">\n1309:           <button data-g=\"Length\" class=\"active\">Length</button>\n1310:           <button data-g=\"Weight\">Weight</button>\n1311:           <button data-g=\"Temperature\">Temp</button>\n1312:           <button data-g=\"Data\">Data</button>\n1313:         </div>\n1314:       </div>\n1315:       <div class=\"content\" style=\"max-width:420px;\">\n1316:         <div style=\"display:flex;gap:10px;align-items:center;margin-bottom:16px;\">\n1317:           <input id=\"un-val\" type=\"number\" value=\"1\" style=\"flex:1;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 10px;color:var(--text-0);font-size:14px;outline:none;\">\n1318:           <select id=\"un-from\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 8px;color:var(--text-0);font-size:13px;outline:none;\"></select>\n1319:           <i data-lucide=\"arrow-right\" style=\"width:15px;height:15px;stroke:var(--text-2);flex:0 0 auto;\"></i>\n1320:           <select id=\"un-to\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 8px;color:var(--text-0);font-size:13px;outline:none;\"></select>\n1321:         </div>\n1322:         <div id=\"un-result\" style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:12px;padding:20px;text-align:center;\">\n1323:           <div style=\"font-family:var(--font-display);font-size:30px;font-weight:600;color:var(--accent);\" id=\"un-result-val\">—</div>\n1324:         </div>\n1325:       </div>\n1326:     </div>\n1327:   `;\n1328:   lucide.createIcons();\n1329:   let group = 'Length';\n1330:   const fromSel = body.querySelector('#un-from');\n1331:   const toSel = body.querySelector('#un-to');\n1332:   const valInput = body.querySelector('#un-val');\n1333:   const resultVal = body.querySelector('#un-result-val');\n1334: \n1335:   function populate(){\n1336:     const units = group==='Temperature' ? ['C','F','K'] : Object.keys(UNIT_GROUPS[group]);\n1337:     fromSel.innerHTML = units.map(u=>`<option value=\"${u}\">${u}</option>`).join('');\n1338:     toSel.innerHTML = units.map((u,i)=>`<option value=\"${u}\" ${i===1?'selected':''}>${u}</option>`).join('');\n1339:     compute();\n1340:   }\n1341:   function tempToC(v,u){ return u==='C'?v : u==='F'? (v-32)*5/9 : v-273.15; }\n1342:   function cToTemp(c,u){ return u==='C'?c : u==='F'? c*9/5+32 : c+273.15; }\n1343:   function compute(){\n1344:     const v = parseFloat(valInput.value);\n1345:     if(isNaN(v)){ resultVal.textContent='—'; return; }\n1346:     let out;\n1347:     if(group==='Temperature'){\n1348:       out = cToTemp(tempToC(v, fromSel.value), toSel.value);\n1349:     } else {\n1350:       const table = UNIT_GROUPS[group];\n1351:       out = v * table[fromSel.value] / table[toSel.value];\n1352:     }\n1353:     resultVal.textContent = (Math.round(out*10000)/10000).toLocaleString() + ' ' + toSel.value;\n1354:   }\n1355:   body.querySelectorAll('#un-group button').forEach(b=>{\n1356:     b.onclick = ()=>{\n1357:       body.querySelectorAll('#un-group button').forEach(x=>x.classList.remove('active'));\n1358:       b.classList.add('active');\n1359:       group = b.dataset.g;\n1360:       populate();\n1361:     };\n1362:   });\n1363:   [valInput, fromSel, toSel].forEach(el=>el.addEventListener('input', compute));\n1364:   populate();\n1365: }\n1366: \n1367: /* ============================================================\n1368:    APP: PHOTO GALLERY (Picsum Photos, real images)\n1369:    ============================================================ */\n1370: function renderGallery(body){\n1371:   body.innerHTML = `\n1372:     <div class=\"app-pane\">\n1373:       <div class=\"app-toolbar\">\n1374:         <div class=\"path\" style=\"text-align:left;\">Curated photo stream</div>\n1375:         <button id=\"gal-shuffle\"><i data-lucide=\"shuffle\"></i></button>\n1376:       </div>\n1377:       <div class=\"content\" id=\"gal-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;\"></div>\n1378:     </div>\n1379:     <div id=\"gal-viewer\" style=\"position:absolute;inset:0;background:rgba(0,0,0,0.9);display:none;align-items:center;justify-content:center;z-index:20;\">\n1380:       <img id=\"gal-viewer-img\" style=\"max-width:90%;max-height:90%;border-radius:8px;\">\n1381:       <button id=\"gal-viewer-close\" style=\"position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.15);border:none;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;\"><i data-lucide=\"x\"></i></button>\n1382:     </div>\n1383:   `;\n1384:   lucide.createIcons();\n1385:   const grid = body.querySelector('#gal-grid');\n1386:   const viewer = body.querySelector('#gal-viewer');\n1387:   const viewerImg = body.querySelector('#gal-viewer-img');\n1388:   function load(){\n1389:     grid.innerHTML='';\n1390:     const seed = Math.floor(Math.random()*10000);\n1391:     for(let i=0;i<18;i++){\n1392:       const img = document.createElement('img');\n1393:       const id = seed + i;\n1394:       img.src = `https://picsum.photos/seed/${id}/240/240`;\n1395:       img.loading='lazy';\n1396:       img.style.cssText = 'width:100%;aspect-ratio:1;object-fit:cover;border-radius:9px;cursor:pointer;border:1px solid var(--line-soft);background:var(--bg-2);';\n1397:       img.onclick = ()=>{ viewerImg.src = `https://picsum.photos/seed/${id}/1200/1200`; viewer.style.display='flex'; };\n1398:       grid.appendChild(img);\n1399:     }\n1400:   }\n1401:   body.querySelector('#gal-shuffle').onclick = load;\n1402:   body.querySelector('#gal-viewer-close').onclick = ()=> viewer.style.display='none';\n1403:   viewer.onclick = (e)=>{ if(e.target===viewer) viewer.style.display='none'; };\n1404:   load();\n1405: }\n1406: \n1407: /* ============================================================\n1408:    APP: MUSIC PLAYER (real playable audio, SoundHelix demo tracks)\n1409:    ============================================================ */\n1410: const MUSIC_TRACKS = Array.from({length:10}, (_,i)=>({\n1411:   title:`Session ${i+1}`, artist:'Endroid Sessions',\n1412:   src:`https://www.soundhelix.com/examples/mp3/SoundHelix-Song-${i+1}.mp3`\n1413: }));\n1414: function renderMusic(body){\n1415:   body.innerHTML = `\n1416:     <div class=\"app-pane\">\n1417:       <div class=\"content\" style=\"display:flex;flex-direction:column;height:100%;padding:0;\">\n1418:         <div style=\"padding:20px 20px 14px;text-align:center;border-bottom:1px solid var(--line-soft);\">\n1419:           <div style=\"width:120px;height:120px;border-radius:14px;background:linear-gradient(145deg,var(--accent),var(--accent-dim));display:flex;align-items:center;justify-content:center;margin:0 auto 14px;\">\n1420:             <i data-lucide=\"music-4\" style=\"width:44px;height:44px;stroke:#08110F;\"></i>\n1421:           </div>\n1422:           <div id=\"mu-title\" style=\"font-family:var(--font-display);font-weight:600;font-size:15px;color:var(--text-0);\"></div>\n1423:           <div id=\"mu-artist\" style=\"font-size:11.5px;color:var(--text-2);margin-top:2px;\"></div>\n1424:           <div style=\"display:flex;align-items:center;gap:8px;margin-top:14px;\">\n1425:             <span id=\"mu-cur\" style=\"font-size:10px;color:var(--text-2);font-family:var(--font-mono);width:32px;\">0:00</span>\n1426:             <input id=\"mu-seek\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" style=\"flex:1;accent-color:var(--accent);\">\n1427:             <span id=\"mu-dur\" style=\"font-size:10px;color:var(--text-2);font-family:var(--font-mono);width:32px;\">0:00</span>\n1428:           </div>\n1429:           <div style=\"display:flex;align-items:center;justify-content:center;gap:14px;margin-top:12px;\">\n1430:             <button id=\"mu-prev\" style=\"background:none;border:none;color:var(--text-1);cursor:pointer;\"><i data-lucide=\"skip-back\"></i></button>\n1431:             <button id=\"mu-play\" style=\"background:var(--accent);border:none;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:#08110F;cursor:pointer;\"><i data-lucide=\"play\"></i></button>\n1432:             <button id=\"mu-next\" style=\"background:none;border:none;color:var(--text-1);cursor:pointer;\"><i data-lucide=\"skip-forward\"></i></button>\n1433:           </div>\n1434:         </div>\n1435:         <div id=\"mu-list\" style=\"flex:1;overflow-y:auto;\"></div>\n1436:       </div>\n1437:     </div>\n1438:   `;\n1439:   lucide.createIcons();\n1440:   const audio = new Audio();\n1441:   let idx = 0;\n1442:   const titleEl = body.querySelector('#mu-title');\n1443:   const artistEl = body.querySelector('#mu-artist');\n1444:   const playBtn = body.querySelector('#mu-play');\n1445:   const seek = body.querySelector('#mu-seek');\n1446:   const curEl = body.querySelector('#mu-cur');\n1447:   const durEl = body.querySelector('#mu-dur');\n1448:   const listEl = body.querySelector('#mu-list');\n1449: \n1450:   function fmt(s){ if(!isFinite(s)) return '0:00'; const m=Math.floor(s/60), sec=Math.floor(s%60); return m+':'+String(sec).padStart(2,'0'); }\n1451:   function drawList(){\n1452:     listEl.innerHTML = MUSIC_TRACKS.map((t,i)=>`\n1453:       <div class=\"note-row ${i===idx?'active':''}\" data-i=\"${i}\" style=\"display:flex;align-items:center;gap:10px;\">\n1454:         <i data-lucide=\"${i===idx?'volume-2':'music-2'}\" style=\"width:14px;height:14px;stroke:var(--accent);flex:0 0 auto;\"></i>\n1455:         <div style=\"flex:1;\"><div class=\"nt\">${t.title}</div><div class=\"np\">${t.artist}</div></div>\n1456:       </div>`).join('');\n1457:     lucide.createIcons();\n1458:     listEl.querySelectorAll('.note-row').forEach(r=>{\n1459:       r.onclick = ()=>{ idx = Number(r.dataset.i); loadTrack(true); };\n1460:     });\n1461:   }\n1462:   function loadTrack(autoplay){\n1463:     const t = MUSIC_TRACKS[idx];\n1464:     titleEl.textContent = t.title;\n1465:     artistEl.textContent = t.artist;\n1466:     audio.src = t.src;\n1467:     drawList();\n1468:     if(autoplay) audio.play().catch(()=>{});\n1469:   }\n1470:   audio.addEventListener('loadedmetadata', ()=>{ durEl.textContent = fmt(audio.duration); });\n1471:   audio.addEventListener('timeupdate', ()=>{\n1472:     curEl.textContent = fmt(audio.currentTime);\n1473:     seek.value = audio.duration ? (audio.currentTime/audio.duration)*100 : 0;\n1474:   });\n1475:   audio.addEventListener('play', ()=>{ playBtn.innerHTML = '<i data-lucide=\"pause\"></i>'; lucide.createIcons(); });\n1476:   audio.addEventListener('pause', ()=>{ playBtn.innerHTML = '<i data-lucide=\"play\"></i>'; lucide.createIcons(); });\n1477:   audio.addEventListener('ended', ()=>{ idx = (idx+1)%MUSIC_TRACKS.length; loadTrack(true); });\n1478: \n1479:   playBtn.onclick = ()=>{ audio.paused ? audio.play().catch(()=>{}) : audio.pause(); };\n1480:   body.querySelector('#mu-prev').onclick = ()=>{ idx = (idx-1+MUSIC_TRACKS.length)%MUSIC_TRACKS.length; loadTrack(true); };\n1481:   body.querySelector('#mu-next').onclick = ()=>{ idx = (idx+1)%MUSIC_TRACKS.length; loadTrack(true); };\n1482:   seek.addEventListener('input', ()=>{ if(audio.duration) audio.currentTime = (seek.value/100)*audio.duration; });\n1483: \n1484:   loadTrack(false);\n1485: }\n1486: \n1487: /* ============================================================\n1488:    APP: CALENDAR (working month view + localStorage events)\n1489:    ============================================================ */\n1490: function loadCalEvents(){ try{ return JSON.parse(localStorage.getItem('endroid_cal')) || {}; }catch(e){ return {}; } }\n1491: function saveCalEvents(o){ localStorage.setItem('endroid_cal', JSON.stringify(o)); }\n1492: function renderCalendar(body){\n1493:   let view = new Date(); view.setDate(1);\n1494:   let selected = new Date();\n1495:   let events = loadCalEvents();\n1496:   body.innerHTML = `\n1497:     <div class=\"app-pane\">\n1498:       <div class=\"app-toolbar\">\n1499:         <button id=\"cal-prev\"><i data-lucide=\"chevron-left\"></i></button>\n1500:         <div class=\"path\" id=\"cal-label\" style=\"text-align:center;\"></div>\n1501:         <button id=\"cal-next\"><i data-lucide=\"chevron-right\"></i></button>\n1502:         <button id=\"cal-today\"><i data-lucide=\"calendar-check\"></i></button>\n1503:       </div>\n1504:       <div class=\"split\" style=\"height:calc(100% - 51px);\">\n1505:         <div style=\"flex:1;padding:12px;overflow-y:auto;\">\n1506:           <div id=\"cal-grid\" style=\"display:grid;grid-template-columns:repeat(7,1fr);gap:4px;\"></div>\n1507:         </div>\n1508:         <div class=\"sidebar\" style=\"width:200px;\">\n1509:           <div style=\"padding:6px 6px 10px;font-size:11px;color:var(--text-2);text-transform:uppercase;letter-spacing:0.4px;\" id=\"cal-sel-label\"></div>\n1510:           <div id=\"cal-events\" style=\"display:flex;flex-direction:column;gap:6px;padding:0 6px;\"></div>\n1511:           <div style=\"padding:10px 6px;\">\n1512:             <input id=\"cal-new-event\" type=\"text\" placeholder=\"Add a note…\" style=\"width:100%;background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:8px 9px;color:var(--text-0);font-size:12px;outline:none;\">\n1513:           </div>\n1514:         </div>\n1515:       </div>\n1516:     </div>\n1517:   `;\n1518:   lucide.createIcons();\n1519:   const grid = body.querySelector('#cal-grid');\n1520:   const label = body.querySelector('#cal-label');\n1521:   const evList = body.querySelector('#cal-events');\n1522:   const selLabel = body.querySelector('#cal-sel-label');\n1523:   const newInput = body.querySelector('#cal-new-event');\n1524:   const dayNames = ['Su','Mo','Tu','We','Th','Fr','Sa'];\n1525:   function key(d){ return d.toISOString().slice(0,10); }\n1526:   function draw(){\n1527:     label.textContent = view.toLocaleDateString([], {month:'long', year:'numeric'});\n1528:     grid.innerHTML = dayNames.map(d=>`<div style=\"text-align:center;font-size:10px;color:var(--text-2);padding:4px 0;\">${d}</div>`).join('');\n1529:     const first = new Date(view.getFullYear(), view.getMonth(), 1);\n1530:     const startOffset = first.getDay();\n1531:     const daysInMonth = new Date(view.getFullYear(), view.getMonth()+1, 0).getDate();\n1532:     const today = new Date();\n1533:     for(let i=0;i<startOffset;i++) grid.innerHTML += `<div></div>`;\n1534:     for(let d=1; d<=daysInMonth; d++){\n1535:       const date = new Date(view.getFullYear(), view.getMonth(), d);\n1536:       const isToday = date.toDateString()===today.toDateString();\n1537:       const isSel = date.toDateString()===selected.toDateString();\n1538:       const hasEv = (events[key(date)]||[]).length>0;\n1539:       const cell = document.createElement('div');\n1540:       cell.style.cssText = `aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:8px;cursor:pointer;font-size:12px;position:relative;\n1541:         background:${isSel?'var(--accent-glow)':'transparent'};color:${isToday?'var(--accent)':'var(--text-0)'};font-weight:${isToday?'700':'400'};`;\n1542:       cell.innerHTML = `${d}${hasEv?'<div style=\"width:4px;height:4px;border-radius:50%;background:var(--accent);position:absolute;bottom:4px;\"></div>':''}`;\n1543:       cell.onclick = ()=>{ selected = date; draw(); };\n1544:       grid.appendChild(cell);\n1545:     }\n1546:     selLabel.textContent = selected.toLocaleDateString([], {weekday:'long', month:'short', day:'numeric'});\n1547:     const evs = events[key(selected)] || [];\n1548:     evList.innerHTML = evs.length ? evs.map((e,i)=>`\n1549:       <div style=\"background:var(--bg-2);border:1px solid var(--line-soft);border-radius:8px;padding:8px 10px;display:flex;align-items:center;gap:8px;\">\n1550:         <div style=\"flex:1;font-size:12px;color:var(--text-0);\">${e}</div>\n1551:         <button data-i=\"${i}\" class=\"cal-del\" style=\"background:none;border:none;color:var(--text-2);cursor:pointer;\"><i data-lucide=\"x\" style=\"width:12px;height:12px;\"></i></button>\n1552:       </div>`).join('') : `<div style=\"font-size:11.5px;color:var(--text-2);padding:4px 0;\">No notes for this day</div>`;\n1553:     lucide.createIcons();\n1554:     evList.querySelectorAll('.cal-del').forEach(btn=>{\n1555:       btn.onclick = ()=>{\n1556:         const i = Number(btn.dataset.i);\n1557:         events[key(selected)].splice(i,1);\n1558:         saveCalEvents(events);\n1559:         draw(